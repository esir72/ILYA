(function() {
	var track = document.getElementById("carousel-track");
	var slides = track.querySelectorAll(".carousel-slide");
	var prevBtn = document.getElementById("carousel-prev");
	var nextBtn = document.getElementById("carousel-next");
	var dots = document.querySelectorAll(".carousel-dot");
	var current = 0;
	function goTo(index) {
		if (index < 0) index = slides.length - 1;
		if (index >= slides.length) index = 0;
		current = index;
		track.style.transform = "translateX(-" + current * 100 + "%)";
		dots.forEach(function(d, i) {
			d.classList.toggle("active", i === current);
		});
		// collapse all slides
		slides.forEach(function(s) {
			s.classList.remove("expanded");
		});
		updateToggleText();
	}
	function getToggleBtn(slide) {
		return slide.querySelector(".carousel-toggle-btn");
	}
	function updateToggleText() {
		slides.forEach(function(s) {
			var btn = getToggleBtn(s);
			if (window.i18n && window.i18n.loaded) {
				btn.textContent = s.classList.contains("expanded") ? window.i18n.t("tools.collapse") : window.i18n.t("tools.expand");
			} else {
				btn.textContent = s.classList.contains("expanded") ? "Свернуть" : "Подробнее";
			}
		});
	}
	prevBtn.addEventListener("click", function() {
		goTo(current - 1);
	});
	nextBtn.addEventListener("click", function() {
		goTo(current + 1);
	});
	dots.forEach(function(dot) {
		dot.addEventListener("click", function() {
			goTo(parseInt(dot.dataset.slide));
		});
	});
	slides.forEach(function(slide) {
		var btn = getToggleBtn(slide);
		btn.addEventListener("click", function(e) {
			e.stopPropagation();
			slide.classList.toggle("expanded");
			updateToggleText();
		});
	});
	// keyboard
	document.addEventListener("keydown", function(e) {
		if (e.key === "ArrowLeft") goTo(current - 1);
		if (e.key === "ArrowRight") goTo(current + 1);
	});
	goTo(0);
})();

