---

---

<section class="hero gloss-overlay">
  <div class="hero-gloss"></div>
  <div class="container hero-inner">
    <img class="hero-logo" src="/images/logo.png" alt="Илья — мастер резьбы по дереву" data-animate="fade" />
    <div class="hero-nav" data-animate="fade" data-delay="1">
      <a href="#products" class="btn hero-btn" data-i18n="hero.cardProducts">Изделия</a>
      <a href="#tools" class="btn hero-btn" data-i18n="hero.cardTools">Инструменты</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px;
    background: linear-gradient(180deg, var(--bg) 0%, var(--beige) 100%);
    position: relative;
    overflow: hidden;
  }

  .gloss-overlay {
    position: relative;
    overflow: hidden;
  }

  .gloss-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.06) 45%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.06) 55%, transparent 70%);
  }

  .hero-gloss {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-gloss::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.04) 50%, transparent);
    animation: gloss-sweep 8s ease-in-out infinite;
  }

  @keyframes gloss-sweep {
    0% { transform: translateX(-100%) skewX(-15deg); }
    30%, 100% { transform: translateX(200%) skewX(-15deg); }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 48px;
    position: relative;
    z-index: 2;
  }

  .hero .container {
    max-width: none;
  }

  .hero-logo {
    width: 100%;
    max-width: calc((100vh - 190px) / 9 * 16);
    height: auto;
    display: block;
  }

  .hero-nav {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-btn {
    min-width: 200px;
    text-align: center;
    text-decoration: none;
    font-size: 1rem;
    padding: 16px 40px;
  }

  @media (max-width: 480px) {
    .hero-inner {
      gap: 32px;
    }
    .hero-logo {
      max-width: calc((100vh - 220px) / 9 * 16);
    }
    .hero-nav {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }
    .hero-btn {
      width: 100%;
    }
  }
</style>