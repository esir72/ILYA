---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero gloss-overlay">
  <div class="hero-gloss"></div>
  <div class="container hero-inner">
    <img class="hero-logo" src={`${base}/images/logo.png`} alt="Илья — мастер резьбы по дереву" data-animate="fade" />
    <p class="hero-slogan" data-animate="fade" data-delay="1" data-i18n="hero.slogan">
      Мастерство, переданное через года, и любовь к природе в каждом изделии.
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 45%, transparent) 0%, color-mix(in srgb, var(--beige) 45%, transparent) 100%);
    position: relative;
    overflow: hidden;
  }

  .gloss-overlay {
    position: relative;
    overflow: hidden;
  }

  .gloss-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.06) 45%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.06) 55%, transparent 70%);
  }

  .hero-gloss {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-gloss::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.04) 50%, transparent);
    animation: gloss-sweep 8s ease-in-out infinite;
  }

  @keyframes gloss-sweep {
    0% { transform: translateX(-100%) skewX(-15deg); }
    30%, 100% { transform: translateX(200%) skewX(-15deg); }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  .hero .container {
    max-width: none;
  }

  .hero-logo {
    width: 100%;
    max-width: calc((100vh - 140px) / 9 * 16);
    height: auto;
    display: block;
  }

  .hero-slogan {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    color: var(--accent-light);
    max-width: 900px;
    line-height: 1.7;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  @media (max-width: 768px) {
    .hero-slogan {
      font-size: 1.1rem;
      letter-spacing: 0.16em;
    }
  }

  @media (max-width: 480px) {
    .hero-inner {
      gap: 28px;
    }
    .hero-logo {
      max-width: calc((100vh - 180px) / 9 * 16);
    }
    .hero-slogan {
      font-size: 0.95rem;
      letter-spacing: 0.12em;
      line-height: 1.6;
    }
  }
</style>