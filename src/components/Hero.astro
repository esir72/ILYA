<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-label" data-animate="fade" data-delay="1" data-i18n="hero.label">Мастер резьбы по дереву</p>
      <h1 class="hero-title" data-animate data-delay="2" data-i18n="hero.title">Илья</h1>
      <p class="hero-desc" data-animate data-delay="3" data-i18n="hero.desc">
        Создаю уникальные изделия из натурального дерева. Каждая работа — 
        это сочетание традиционного мастерства и современного дизайна.
      </p>
    </div>
    <div class="hero-nav" data-animate data-delay="4">
      <a href="#products" class="hero-card">
        <div class="hero-card-img hero-card-products">
          <span class="hero-card-placeholder" data-i18n="hero.cardProducts">Изделия</span>
        </div>
      </a>
      <a href="#tools" class="hero-card">
        <div class="hero-card-img hero-card-tools">
          <span class="hero-card-placeholder" data-i18n="hero.cardTools">Инструменты</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px;
    background: linear-gradient(180deg, var(--bg) 0%, var(--beige) 100%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: stretch;
  }

  .hero-content {
    max-width: 540px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .hero-title {
    font-size: 4rem;
    margin-bottom: 24px;
    color: var(--text);
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .hero-nav {
    display: flex;
    gap: 24px;
    align-items: stretch;
  }

  .hero-card {
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
    flex: 1;
    display: flex;
  }

  .hero-card:hover {
    transform: translateY(-4px);
  }

  .hero-card-img {
    flex: 1;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s;
  }

  .hero-card:hover .hero-card-img {
    border-color: var(--accent);
  }

  .hero-card-placeholder {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-card-products {
    background: linear-gradient(135deg, var(--surface), var(--beige));
  }

  .hero-card-tools {
    background: linear-gradient(135deg, var(--beige), var(--surface));
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-content {
      margin: 0 auto;
    }
    .hero-title {
      font-size: 3rem;
    }
    .hero-nav {
      flex-direction: row;
      justify-content: center;
      gap: 16px;
    }
    .hero-card {
      flex: 1;
      max-width: 260px;
    }
    .hero-card-img {
      aspect-ratio: 4 / 3;
    }
    .hero-card-placeholder {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-desc {
      font-size: 1rem;
      margin-bottom: 24px;
    }
    .hero-nav {
      flex-direction: column;
      align-items: center;
    }
    .hero-card {
      flex: none;
      width: 100%;
      max-width: 260px;
    }
    .hero-card-img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
