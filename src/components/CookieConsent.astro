<div id="cookie-consent" class="cookie-consent">
  <p class="cookie-text" data-i18n="cookie.text">
    Этот сайт использует файлы cookie для улучшения работы. Продолжая использование сайта, вы соглашаетесь с этим.
  </p>
  <button id="cookie-accept" class="btn cookie-btn" data-i18n="cookie.btn">Принять</button>
</div>

<script>
  if (localStorage.getItem('cookieConsent') !== 'true') {
    const banner = document.getElementById('cookie-consent');
    const accept = document.getElementById('cookie-accept');
    if (banner && accept) {
      setTimeout(() => banner.classList.add('show'), 500);
      accept.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        banner.classList.remove('show');
      });
    }
  }
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--text);
    color: var(--bg);
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 300;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cookie-consent.show {
    transform: translateY(0);
  }

  .cookie-text {
    font-size: 0.9rem;
    max-width: 600px;
    line-height: 1.5;
  }

  .cookie-btn {
    flex-shrink: 0;
    background: var(--accent);
    padding: 10px 24px;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .cookie-btn:hover {
    background: var(--accent-light);
  }

  @media (max-width: 480px) {
    .cookie-consent {
      flex-direction: column;
      text-align: center;
      gap: 12px;
      padding: 16px;
    }
    .cookie-text {
      font-size: 0.85rem;
    }
  }
</style>
