<div id="cookie-consent" class="cookie-consent">
  <p class="cookie-text" data-i18n="cookie.text">
    Мы сохраняем корзину, выбранный язык и настройки согласия. С вашего разрешения подключаем Google Fonts и Яндекс.Метрику.
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept" class="btn cookie-btn" data-i18n="cookie.btn">Принять</button>
    <button id="cookie-reject" class="btn cookie-btn cookie-btn-reject" data-i18n="cookie.btnReject">Только необходимые</button>
  </div>
</div>

<script>
  const consent = localStorage.getItem('cookieConsent');
  if (consent !== 'accepted' && consent !== 'true' && consent !== 'essential') {
    const banner = document.getElementById('cookie-consent');
    const accept = document.getElementById('cookie-accept');
    const reject = document.getElementById('cookie-reject');
    if (banner && accept && reject) {
      setTimeout(() => banner.classList.add('show'), 500);
      accept.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'accepted');
        banner.classList.remove('show');
        window.dispatchEvent(new Event('cookie-consent'));
      });
      reject.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'essential');
        banner.classList.remove('show');
      });
    }
  }
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: max(24px, env(safe-area-inset-bottom));
    left: 24px;
    right: 24px;
    border-radius: 12px;
    background: var(--text);
    color: var(--bg);
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 9999;
    transform: translateY(150%);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cookie-consent.show {
    transform: translateY(0);
  }

  .cookie-text {
    font-size: 0.9rem;
    max-width: 600px;
    line-height: 1.5;
  }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .cookie-btn {
    flex-shrink: 0;
    background: var(--accent);
    padding: 10px 24px;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .cookie-btn:hover {
    background: var(--accent-light);
  }

  .cookie-btn-reject {
    color: var(--bg);
    background: transparent;
    border: 1px solid currentColor;
  }

  .cookie-btn-reject:hover {
    color: var(--bg);
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 768px) {
    .cookie-consent {
      flex-direction: column;
      text-align: center;
      gap: 12px;
      padding: 16px;
      bottom: auto;
      top: max(16px, env(safe-area-inset-top));
      left: 16px;
      right: 16px;
      width: auto;
      transform: translateY(-150%);
      opacity: 1;
      transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      pointer-events: auto;
    }
    .cookie-text {
      font-size: 0.85rem;
    }
  }
</style>
