<script>
  var countObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting && !entry.target.dataset.counted) {
        entry.target.dataset.counted = '1';
        var target = parseInt(entry.target.dataset.count);
        animateCount(entry.target, target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.stat-num').forEach(function (el) {
    countObserver.observe(el);
  });

  function animateCount(el, target) {
    var duration = 1500;
    var start = performance.now();
    function step(now) {
      var progress = Math.min((now - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(eased * target);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  var qnaBtn = document.getElementById('about-qna-btn');
  var qnaModal = document.getElementById('qna-modal');
  var qnaOverlay = document.getElementById('qna-overlay');
  var qnaClose = document.getElementById('qna-close');

  if (qnaBtn && qnaModal) {
    qnaBtn.addEventListener('click', function() {
      qnaModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
    
    function closeQna() {
      qnaModal.classList.remove('open');
      document.body.style.overflow = '';
    }
    
    qnaClose.addEventListener('click', closeQna);
    qnaOverlay.addEventListener('click', closeQna);
  }

</script>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .about-text p {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .stat-item {
    text-align: center;
  }

  .stat-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent);
    letter-spacing: 0.03em;
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-text {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .about-text p {
      font-size: 0.95rem;
    }
  }

  .qna-list::-webkit-scrollbar {
    width: 6px;
