---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const privacyHref = `${base}/privacy`;
---

<section class="section" id="payment">
  <div class="container">
    <div class="order-card" data-animate>
      <div class="order-card-inner">
        <div class="order-ornament"></div>
        <div class="order-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h2 class="order-title" data-i18n="payment.title">Оформить заказ</h2>
        <p class="order-subtitle" data-i18n="payment.subtitle">
          Заполните форму — я свяжусь с вами в удобном мессенджере
        </p>
      <form id="order-form" class="order-form" action="https://formspree.io/f/xbglolqd" method="POST">
          <input type="text" name="_gotcha" style="position:absolute;left:-9999px" tabindex="-1" autocomplete="off" />
          <div class="form-group">
            <label for="order-name">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span data-i18n="payment.nameLabel">Ваше имя</span>
            </label>
            <input type="text" id="order-name" name="name" placeholder="Иван" data-i18n-placeholder="payment.namePlaceholder" required />
          </div>
          <div class="form-group" id="contact-group">
            <label for="order-contact-type">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span data-i18n="payment.phoneLabel">Контакт для связи</span>
            </label>
            <select id="order-contact-type">
              <option value="tg" selected data-i18n="payment.contactOptTg">Ник в соцсетях</option>
              <option value="phone" data-i18n="payment.contactOptPhone">Телефон</option>
            </select>
            <div id="phone-fields">
              <label for="order-country" data-i18n="payment.phoneRegionLabel">Регион / страна</label>
              <select id="order-country" name="phone_country">
                <option value="ru" selected data-i18n="payment.country.ru">Россия (+7)</option>
                <option value="by" data-i18n="payment.country.by">Беларусь (+375)</option>
                <option value="kz" data-i18n="payment.country.kz">Казахстан (+7)</option>
                <option value="ua" data-i18n="payment.country.ua">Украина (+380)</option>
                <option value="am" data-i18n="payment.country.am">Армения (+374)</option>
                <option value="ge" data-i18n="payment.country.ge">Грузия (+995)</option>
                <option value="md" data-i18n="payment.country.md">Молдова (+373)</option>
                <option value="uz" data-i18n="payment.country.uz">Узбекистан (+998)</option>
                <option value="kg" data-i18n="payment.country.kg">Кыргызстан (+996)</option>
                <option value="tj" data-i18n="payment.country.tj">Таджикистан (+992)</option>
                <option value="az" data-i18n="payment.country.az">Азербайджан (+994)</option>
                <option value="other" data-i18n="payment.country.other">Другая страна (+...)</option>
              </select>
              <input type="tel" id="order-phone" name="phone" class="form-phone" placeholder="+7 (___) ___-__-__" autocomplete="tel" inputmode="tel" required />
            </div>
            <input type="text" id="order-tg" name="phone" class="form-tg" placeholder="@username" autocomplete="off" disabled />
            <p class="form-hint" id="contact-hint" data-i18n="payment.phoneHint">Введите номер в выбранном формате — только цифры</p>
          </div>
          <div class="form-group">
            <label for="order-messenger">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span data-i18n="payment.messengerLabel">Куда написать?</span>
            </label>
            <select id="order-messenger" name="messenger" required>
              <option value="" disabled selected data-i18n="payment.messengerPlaceholder">Выберите мессенджер</option>
              <option value="telegram" data-i18n="payment.messengerOptTelegram">Telegram</option>
              <option value="whatsapp" data-i18n="payment.messengerOptWhatsApp">WhatsApp</option>
              <option value="viber" data-i18n="payment.messengerOptViber">Viber</option>
              <option value="max" data-i18n="payment.messengerOptMax">Макс</option>
              <option value="sms" data-i18n="payment.messengerOptSMS">SMS</option>
            </select>
            <p class="form-hint" data-i18n="payment.messengerHint">Убедитесь, что в выбранной соцсети открыт номер для связи</p>
          </div>
          <input type="hidden" name="cart" id="order-cart" />
          <div class="form-divider"></div>
          <div class="form-group">
            <label for="order-delivery">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span data-i18n="payment.deliveryLabel">Способ доставки</span>
            </label>
            <select id="order-delivery" name="delivery" required>
              <option value="" disabled selected data-i18n="payment.deliveryPlaceholder">Выберите способ доставки</option>
              <option value="Почта России" data-i18n="payment.deliveryOptPost">Почта России</option>
              <option value="СДЭК" data-i18n="payment.deliveryOptCDEK">СДЭК (до пункта выдачи)</option>
              <option value="Другое" data-i18n="payment.deliveryOptOther">Другое</option>
            </select>
          </div>
          <div class="form-group" id="address-group">
            <label for="order-address">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-i18n="payment.addressLabel">Адрес доставки</span>
            </label>
            <input type="text" id="order-address" name="address" placeholder="Город, улица, дом, квартира / индекс" data-i18n-placeholder="payment.addressPlaceholder" />
          </div>
          <div class="form-group">
            <label for="order-comment">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span data-i18n="payment.commentLabel">Комментарий к заказу</span>
            </label>
            <textarea id="order-comment" name="comment" rows="4" placeholder="Пожелания, уточнения, размеры, материалы и т.д." data-i18n-placeholder="payment.commentPlaceholder"></textarea>
          </div>
          <button type="submit" class="order-btn">
            <span data-i18n="payment.btnSubmit">Отправить</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
          <p class="form-agreement">
            <span data-i18n="payment.agreement">Нажимая «Отправить», вы соглашаетесь с</span><span> </span><a href={privacyHref} data-i18n="payment.agreementLink">обработкой персональных данных</a>
          </p>
          <div id="form-success" class="form-success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p data-i18n="payment.success">Спасибо! Я свяжусь с вами в ближайшее время.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  interface CountryConfig {
    mask: string;
    min: number;
    max: number;
  }

  const FALLBACK_COUNTRY: CountryConfig = {
    mask: '+___ ___ ___ ____',
    min: 7,
    max: 13
  };

  const COUNTRIES: Record<string, CountryConfig> = {
    ru: { mask: '+7 (___) ___-__-__', min: 11, max: 10 },
    by: { mask: '+375 (__) ___-__-__', min: 12, max: 9 },
    kz: { mask: '+7 (___) ___-__-__', min: 11, max: 10 },
    ua: { mask: '+380 (__) ___-__-__', min: 12, max: 9 },
    am: { mask: '+374 (__) ______', min: 11, max: 8 },
    ge: { mask: '+995 (___) __-__-__', min: 12, max: 9 },
    md: { mask: '+373 (__) ___-__', min: 11, max: 8 },
    uz: { mask: '+998 (__) ___-__-__', min: 12, max: 9 },
    kg: { mask: '+996 (___) __-__-__', min: 12, max: 9 },
    tj: { mask: '+992 (___) __-__-__', min: 12, max: 9 },
    az: { mask: '+994 (___) __-__-__', min: 12, max: 9 },
    other: FALLBACK_COUNTRY
  };

  const FALLBACK: Record<string, string> = {
    'payment.phoneHint': 'Введите номер в выбранном формате — только цифры',
    'payment.tgHint': 'Укажите ваш ник в соцсетях, например @ilya',
    'payment.phoneErrorShort': 'Номер слишком короткий для выбранной страны',
    'payment.tgError': 'Ник должен содержать 4–32 символа: буквы, цифры или _',
    'payment.btnSending': 'Отправка...'
  };

  function t(key: string): string {
    const i18n: I18n | undefined = window.i18n;
    if (i18n?.loaded) return i18n.t(key);
    return FALLBACK[key] ?? key;
  }

  function getCountryConfig(country: string): CountryConfig {
    return COUNTRIES[country] ?? FALLBACK_COUNTRY;
  }

  const contactTypeSelect = document.querySelector<HTMLSelectElement>('#order-contact-type');
  const countrySelect = document.querySelector<HTMLSelectElement>('#order-country');
  const phoneInput = document.querySelector<HTMLInputElement>('#order-phone');
  const tgInput = document.querySelector<HTMLInputElement>('#order-tg');
  const contactHint = document.querySelector<HTMLElement>('#contact-hint');

  function maskPhone(digits: string, mask: string): string {
    let out = '';
    let digitIndex = 0;
    for (let index = 0; index < mask.length && digitIndex < digits.length; index++) {
      out += mask[index] === '_' ? digits[digitIndex++] : mask[index];
    }
    return out;
  }

  if (contactTypeSelect && countrySelect && phoneInput && tgInput && contactHint) {
    const contactType = contactTypeSelect;
    const country = countrySelect;
    const phone = phoneInput;
    const telegram = tgInput;
    const hint = contactHint;

    function applyContact(): void {
      const isTelegram = contactType.value === 'tg';
      const group = document.getElementById('contact-group');
      if (group) group.classList.toggle('tg-mode', isTelegram);
      country.disabled = isTelegram;
      phone.disabled = isTelegram;
      phone.required = !isTelegram;
      telegram.disabled = !isTelegram;
      telegram.required = isTelegram;
      if (isTelegram) {
        phone.value = '';
        phone.setCustomValidity('');
        hint.textContent = t('payment.tgHint');
        validateTelegram();
      } else {
        telegram.value = '';
        telegram.setCustomValidity('');
        phone.placeholder = getCountryConfig(country.value).mask;
        hint.textContent = t('payment.phoneHint');
        validatePhone();
      }
    }

    function validatePhone(): void {
      if (contactType.value === 'tg') return;
      const config = getCountryConfig(country.value);
      const digits = phone.value.replace(/\D/g, '');
      const empty = digits.length === 0;
      const valid = empty || digits.length >= config.min;
      phone.setCustomValidity(valid ? '' : t('payment.phoneErrorShort'));
      hint.classList.toggle('error', !empty && !valid);
      hint.textContent = valid ? t('payment.phoneHint') : t('payment.phoneErrorShort');
    }

    function validateTelegram(): void {
      const username = telegram.value.replace(/^@/, '');
      const empty = username.length === 0;
      const valid = empty || /^[A-Za-z0-9_]{4,32}$/.test(username);
      telegram.setCustomValidity(valid ? '' : t('payment.tgError'));
      hint.classList.toggle('error', !empty && !valid);
      hint.textContent = valid ? t('payment.tgHint') : t('payment.tgError');
    }

    function countDigits(value: string): number {
      return value.replace(/\D/g, '').length;
    }

    function caretAfterDigits(value: string, prefixLength: number, digitCount: number): number {
      if (digitCount <= 0) return prefixLength;
      let seen = 0;
      for (let index = prefixLength; index < value.length; index++) {
        if (/\d/.test(value[index]) && ++seen === digitCount) return index + 1;
      }
      return value.length;
    }

    function applyPhoneEdit(type: string, data: string | null, start: number | null, end: number | null): { value: string; pos: number } | null | undefined {
      if (start === null || end === null) return undefined;
      const config = getCountryConfig(country.value);
      const prefixLength = config.mask.indexOf('_');
      const oldValue = phone.value;
      const digits = oldValue.slice(prefixLength).replace(/\D/g, '');
      const digitsBeforeSelection = countDigits(oldValue.slice(prefixLength, start));
      const selectedDigits = countDigits(oldValue.slice(Math.max(start, prefixLength), end));
      const nextDigits = digits.split('');
      let caretDigits: number;
      if (type === 'deleteContentBackward') {
        if (selectedDigits === 0) {
          if (start <= prefixLength || !/\d/.test(oldValue.slice(start - 1, start)) || digitsBeforeSelection === 0) return null;
          nextDigits.splice(digitsBeforeSelection - 1, 1);
          caretDigits = digitsBeforeSelection - 1;
        } else {
          nextDigits.splice(digitsBeforeSelection, selectedDigits);
          caretDigits = digitsBeforeSelection;
        }
      } else if (type === 'deleteContentForward' || type === 'deleteByCut') {
        if (selectedDigits === 0) {
          if (start < prefixLength || !/\d/.test(oldValue.slice(start, start + 1)) || digitsBeforeSelection >= nextDigits.length) return null;
          nextDigits.splice(digitsBeforeSelection, 1);
          caretDigits = digitsBeforeSelection;
        } else {
          nextDigits.splice(digitsBeforeSelection, selectedDigits);
          caretDigits = digitsBeforeSelection;
        }
      } else if (type.startsWith('insert')) {
        const insertedDigits = (data ?? '').replace(/\D/g, '').split('');
        nextDigits.splice(digitsBeforeSelection, selectedDigits, ...insertedDigits);
        caretDigits = digitsBeforeSelection + insertedDigits.length;
      } else {
        return undefined;
      }
      const value = maskPhone(nextDigits.slice(0, config.max).join(''), config.mask);
      return { value, pos: caretAfterDigits(value, prefixLength, caretDigits) };
    }

    contactType.addEventListener('change', applyContact);
    country.addEventListener('change', applyContact);
    phone.addEventListener('beforeinput', function (event: InputEvent) {
      const result = applyPhoneEdit(event.inputType, event.data, phone.selectionStart, phone.selectionEnd);
      if (result === undefined) return;
      event.preventDefault();
      if (result !== null) {
        phone.value = result.value;
        try {
          phone.setSelectionRange(result.pos, result.pos);
        } catch {}
      }
      validatePhone();
    });
    telegram.addEventListener('input', validateTelegram);
    document.addEventListener('langchange', applyContact);
    const orderForm = document.querySelector<HTMLFormElement>('#order-form');
    if (orderForm) orderForm.addEventListener('reset', applyContact);
    applyContact();
  }

  function isCartItem(value: unknown): value is CartItem {
    if (typeof value !== 'object' || value === null) return false;
    const item = value as Record<string, unknown>;
    return (
      typeof item.id === 'number' &&
      Number.isFinite(item.id) &&
      typeof item.title === 'string' &&
      typeof item.i18nKey === 'string' &&
      typeof item.price === 'number' &&
      Number.isFinite(item.price) &&
      typeof item.qty === 'number' &&
      Number.isInteger(item.qty) &&
      item.qty > 0 &&
      typeof item.img === 'string' &&
      typeof item.color === 'string' &&
      typeof item.colorKey === 'string'
    );
  }

  function readCart(): CartItem[] {
    try {
      const storedCart = localStorage.getItem('cart');
      if (storedCart === null) return [];
      const parsedCart: unknown = JSON.parse(storedCart);
      return Array.isArray(parsedCart) ? parsedCart.filter(isCartItem) : [];
    } catch {
      return [];
    }
  }

  function getItemPrice(item: CartItem): number {
    if (window.i18n.lang !== 'en') return item.price;
    if (item.id === 9) return 110;
    if (item.id === 10) return 170;
    if (item.id === 11) return 50;
    return Math.ceil(item.price / 100);
  }

  function formatPrice(price: number): string {
    if (window.i18n.lang === 'en') {
      if (price === 0) return 'Price on request';
      return '$' + price.toLocaleString('en-US');
    }
    return price.toLocaleString('ru-RU') + ' ₽';
  }

  const form = document.querySelector<HTMLFormElement>('#order-form');
  const cartInput = document.querySelector<HTMLInputElement>('#order-cart');
  let submitting = false;
  if (form) {
    form.addEventListener('submit', function (event) {
      if (submitting) {
        event.preventDefault();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('.order-btn');
      if (!button) return;
      submitting = true;
      const items = readCart();
      if (cartInput && items.length > 0) {
        const lines = items.map(function (item) {
          const subtotal = formatPrice(getItemPrice(item) * item.qty);
          const colorPart = item.color ? ' (Цвет: ' + item.color + ')' : '';
          return '- ' + item.title + colorPart + ' x ' + item.qty + ' = ' + subtotal;
        });
        const total = items.reduce(function (sum, item) {
          return sum + getItemPrice(item) * item.qty;
        }, 0);
        lines.push('');
        lines.push('Итого: ' + formatPrice(total));
        cartInput.value = lines.join('\n');
      }
      button.disabled = true;
      button.innerHTML = t('payment.btnSending');
      setTimeout(function () {
        localStorage.removeItem('cart');
        if (typeof window.initCart === 'function') window.initCart();
      }, 500);
    });
  }
</script>

<style>
  .order-card {
    max-width: 540px;
    margin: 0 auto;
  }

  .order-card-inner {
    background: linear-gradient(135deg, var(--surface), var(--beige));
    border: 1px solid var(--border);
    padding: 48px 40px 40px;
    position: relative;
  }

  .order-ornament {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .order-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--accent);
  }

  .order-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    text-align: center;
    margin-bottom: 8px;
  }

  .order-subtitle {
    text-align: center;
    color: var(--text-light);
    font-size: 0.95rem;
    margin-bottom: 32px;
    line-height: 1.6;
    max-width: 380px;
    margin-left: auto;
    margin-right: auto;
  }

  .order-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 14px 16px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
    border-radius: 0;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-light);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(200, 169, 110, 0.35);
  }

  .form-group select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23D3A05A' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 44px;
  }

  .form-group input[disabled] {
    display: none;
  }

  #contact-group.tg-mode #phone-fields {
    display: none;
  }

  #phone-fields {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-hint {
    font-size: 0.78rem;
    color: var(--text-light);
    line-height: 1.4;
  }

  .form-hint.error {
    color: #e07a72;
  }

  .form-group input.error,
  .form-group select.error {
    border-color: #e07a72;
  }

  .form-divider {
    height: 1px;
    background: var(--border);
    margin: 4px 0;
  }

  .order-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    background: var(--accent-fill);
    color: #fff;
    border: none;
    font-family: var(--font-body);
    font-size: 1rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background 0.25s, gap 0.25s;
  }

  .order-btn:hover {
    background: var(--accent-fill-light);
    gap: 14px;
  }

  .order-btn:active {
