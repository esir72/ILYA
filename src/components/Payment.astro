---
---

<section class="section" id="payment">
  <div class="container">
    <div class="order-card" data-animate>
      <div class="order-card-inner">
        <div class="order-ornament"></div>
        <div class="order-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h2 class="order-title" data-i18n="payment.title">Оформить заказ</h2>
        <p class="order-subtitle" data-i18n="payment.subtitle">
          Заполните форму — я свяжусь с вами в удобном мессенджере
        </p>
      <form id="order-form" class="order-form" action="https://formspree.io/f/xpqvdaed" method="POST">
          <div class="form-group">
            <label for="order-name">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span data-i18n="payment.nameLabel">Ваше имя</span>
            </label>
            <input type="text" id="order-name" name="name" placeholder="Иван" data-i18n-placeholder="payment.namePlaceholder" required />
          </div>
          <div class="form-group">
            <label for="order-phone">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span data-i18n="payment.phoneLabel">Телефон для связи</span>
            </label>
            <input type="tel" id="order-phone" name="phone" placeholder="+7 (___) ___-__-__" data-i18n-placeholder="payment.phonePlaceholder" required />
          </div>
          <div class="form-group">
            <label for="order-messenger">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span data-i18n="payment.messengerLabel">Куда написать?</span>
            </label>
            <select id="order-messenger" name="messenger" required>
              <option value="" disabled selected data-i18n="payment.messengerPlaceholder">Выберите мессенджер</option>
              <option value="telegram" data-i18n="payment.messengerOptTelegram">Telegram</option>
              <option value="whatsapp" data-i18n="payment.messengerOptWhatsApp">WhatsApp</option>
              <option value="viber" data-i18n="payment.messengerOptViber">Viber</option>
              <option value="sms" data-i18n="payment.messengerOptSMS">SMS</option>
            </select>
            <p class="form-hint" data-i18n="payment.messengerHint">Убедитесь, что в выбранной соцсети открыт номер для связи</p>
          </div>
          <input type="hidden" name="cart" id="order-cart" />
          <div class="form-divider"></div>
          <div class="form-group">
            <label for="order-delivery">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span data-i18n="payment.deliveryLabel">Способ доставки</span>
            </label>
            <select id="order-delivery" name="delivery" required>
              <option value="" disabled selected data-i18n="payment.deliveryPlaceholder">Выберите способ доставки</option>
              <option value="post" data-i18n="payment.deliveryOptPost">Почта России</option>
              <option value="courier" data-i18n="payment.deliveryOptCourier">Курьер (СДЭК)</option>
              <option value="boxberry" data-i18n="payment.deliveryOptBoxberry">Boxberry</option>
              <option value="pickpoint" data-i18n="payment.deliveryOptPickpoint">PickPoint</option>
              <option value="dhl" data-i18n="payment.deliveryOptDHL">DHL</option>
            </select>
          </div>
          <div class="form-group" id="address-group">
            <label for="order-address">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-i18n="payment.addressLabel">Адрес доставки</span>
            </label>
            <input type="text" id="order-address" name="address" placeholder="Город, улица, дом, квартира / индекс" data-i18n-placeholder="payment.addressPlaceholder" />
          </div>
          <button type="submit" class="order-btn">
            <span data-i18n="payment.btnSubmit">Отправить</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
          <p class="form-agreement">
            <span data-i18n="payment.agreement">Нажимая «Отправить», вы соглашаетесь с</span><span> </span><a href="/privacy" data-i18n="payment.agreementLink">обработкой персональных данных</a>
          </p>
          <div id="form-success" class="form-success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p data-i18n="payment.success">Спасибо! Я свяжусь с вами в ближайшее время.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const i18nBtnText = function () {
    if (window.i18n && window.i18n.loaded) return window.i18n.t('payment.btnSubmit');
    return 'Отправить';
  };
  const i18nSendingText = function () {
    if (window.i18n && window.i18n.loaded) return window.i18n.t('payment.btnSending');
    return 'Отправка...';
  };

  const form = document.getElementById('order-form');
  const success = document.getElementById('form-success');
  const cartInput = document.getElementById('order-cart');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // build cart text from localStorage
      var items = JSON.parse(localStorage.getItem('cart') || '[]');
      if (cartInput && items.length > 0) {
        var lines = items.map(function (item) {
          var sub = (item.price * item.qty).toLocaleString('ru-RU') + ' ₽';
          return '- ' + item.title + ' x ' + item.qty + ' = ' + sub;
        });
        var total = items.reduce(function (s, item) { return s + item.price * item.qty; }, 0);
        lines.push('');
        lines.push('Итого: ' + total.toLocaleString('ru-RU') + ' ₽');
        cartInput.value = lines.join('\n');
      }

      const btn = form.querySelector('.order-btn');
      btn.disabled = true;
      btn.innerHTML = i18nSendingText();
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' },
        });
        if (res.ok) {
          form.reset();
          form.style.display = 'none';
          success.classList.add('show');
          // clear cart
          localStorage.removeItem('cart');
          if (window.initCart) window.initCart();
        }
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>' + i18nBtnText() + '</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
      }
    });
  }
</script>

<style>
  .order-card {
    max-width: 540px;
    margin: 0 auto;
  }

  .order-card-inner {
    background: linear-gradient(135deg, var(--surface), var(--beige));
    border: 1px solid var(--border);
    padding: 48px 40px 40px;
    position: relative;
  }

  .order-ornament {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .order-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--accent);
  }

  .order-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    text-align: center;
    margin-bottom: 8px;
  }

  .order-subtitle {
    text-align: center;
    color: var(--text-light);
    font-size: 0.95rem;
    margin-bottom: 32px;
    line-height: 1.6;
    max-width: 380px;
    margin-left: auto;
    margin-right: auto;
  }

  .order-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select {
    padding: 14px 16px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
    border-radius: 0;
  }

  .form-group input::placeholder {
    color: var(--border);
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(141, 110, 99, 0.1);
  }

  .form-group select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%238D6E63' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 44px;
  }

  .form-hint {
    font-size: 0.78rem;
    color: var(--border);
    line-height: 1.4;
  }

  .form-divider {
    height: 1px;
    background: var(--border);
    margin: 4px 0;
  }

  .order-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    background: var(--accent);
    color: #fff;
    border: none;
    font-family: var(--font-body);
    font-size: 1rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background 0.25s, gap 0.25s;
  }

  .order-btn:hover {
    background: var(--text);
    gap: 14px;
  }

  .order-btn svg {
    transition: transform 0.25s;
  }

  .order-btn:hover svg {
    transform: translateX(4px);
  }

  .form-agreement {
    font-size: 0.78rem;
    color: var(--text-light);
    text-align: center;
    line-height: 1.5;
  }

  .form-agreement a {
    text-decoration: underline;
  }

  .form-success {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 0;
    color: var(--accent);
    text-align: center;
  }

  .form-success.show {
    display: flex;
  }

  .form-success p {
    color: var(--text-light);
    font-size: 0.95rem;
  }

  @media (max-width: 480px) {
    .order-card-inner {
      padding: 36px 20px 28px;
    }
    .order-title {
      font-size: 1.5rem;
    }
    .order-subtitle {
      font-size: 0.88rem;
      margin-bottom: 24px;
    }
  }
</style>
