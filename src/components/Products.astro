    ],
  },
  {
    id: 8,
    title: 'Гэндальф',
    desc: 'Ручная деревянная фигурка Гэндальфа из «Властелина колец», высотой 30 см.\nВыполнена из липы, вручную вырезана и окрашена натуральными морилками. Шляпа и подставка съёмные.\nФигурка изготавливается на заказ, но одна уже готова и есть в наличии.',
    short: 'Ручная деревянная фигурка Гэндальфа из липы, высотой 30 см.',
    price: 200000,
    image: productImage(`${base}/images/cards/gandalf/гендальф.webp`, 789, 1276),
    gallery: [
      `${base}/images/cards/gandalf/photo_2026-09-08_13-10-16.webp`,
    ],
  },
];

const productData: ProductDataItem[] = products.map((p: Product, i: number): ProductDataItem => ({
  id: p.id,
  title: p.title,
  desc: p.desc,
  image: p.image.large,
  price: p.price,
  gallery: [p.image.large, ...p.gallery, `${base}/images/cards/ending.webp`],
  colorsJson: p.colors ? JSON.stringify(p.colors) : '',
  titleKey: `products.item.${i}.title`,
  descKey: `products.item.${i}.desc`,
  priceKey: `products.item.${i}.price`,
  i18nKey: `products.item.${i}.title`,
}));

const formatPrice = (price: number): string => {
  if (price === 0) return 'Цена по запросу';
  return price.toLocaleString('ru-RU') + ' ₽';
};
---

<section class="section" id="products">
  <div class="container">
    <h2 class="section-title" data-animate data-i18n="products.title">Изделия</h2>
    <p class="section-subtitle" data-animate data-delay="1" data-i18n="products.subtitle">
      Каждое изделие уникально. Фактура дерева и рисунок могут незначительно
      отличаться от фото.
    </p>
    <div class="products-hint" data-animate data-delay="2">
      <span class="products-hint-label" data-i18n="products.hint">Нажмите, чтобы узнать подробнее</span>
      <span class="products-hint-row">
        <span class="products-hint-rule" aria-hidden="true"></span>
        <span class="products-hint-icon" aria-hidden="true"></span>
        <span class="products-hint-rule" aria-hidden="true"></span>
      </span>
    </div>
    <div class="products-grid">
      {products.map((product, i) => (
        <article class="product-card" style={`--card-bg: url('${base}/images/cards/BG_stone.webp');`} data-mask={product.image.small} data-animate="scale" data-delay={i + 1} tabindex="0" role="button">
          <div class="card-glow" aria-hidden="true"><span class="glow-static"></span><span class="glow-ring"><span class="glow-runner"></span></span></div>
          <div class="flip-inner">
            <div class="face face-front">
              <div class="flip-front">
                <div class="product-image">
                  <img src={product.image.large} srcset={`${product.image.small} 360w, ${product.image.medium} 540w, ${product.image.large} ${product.image.width}w`} sizes="(max-width: 768px) calc(100vw - 32px), (max-width: 1200px) calc((100vw - 96px) / 3), 380px" width={product.image.width} height={product.image.height} alt={product.title} loading="lazy" decoding="async" />
                </div>
              </div>
            </div>
            <div class="face face-back">
              <div class="flip-back">
                <div class="flip-back-content">
                  <h3 class="product-title" data-i18n={`products.item.${i}.title`}>{product.title}</h3>
                  <p class="product-desc" data-i18n={`products.item.${i}.short`}>{product.short}</p>
                  <div class="product-bottom">
                    <span class="product-price" data-i18n={`products.item.${i}.price`}>{formatPrice(product.price)}</span>
                    <button class="btn btn-sm btn-cart btn-icon-only" data-id={product.id} data-title={product.title} data-i18n-key={`products.item.${i}.title`} data-price={product.price} data-img={product.image.large} data-i18n-title="products.btnCart" aria-label="В корзину">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="product-back-actions">
                    <button class="details-btn" data-details={i} data-i18n="products.details">Подробнее</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-showmore">
      <button id="show-more-btn" class="btn" data-i18n="products.showMore">Показать еще</button>
    </div>
    <div class="products-more" data-animate>
      <p data-i18n="products.moreText">Хотите что-то особенное? Я делаю изделия на заказ.</p>
      <a href="#payment" class="btn" data-i18n="products.moreBtn">Обсудить заказ</a>
    </div>
  </div>

  <div id="detail-modal" class="detail-modal" aria-hidden="true">
    <div class="detail-overlay"></div>
    <div class="detail-content" role="dialog" aria-modal="true">
      <button class="detail-close" id="detail-close" aria-label="Закрыть" data-i18n-aria="products.detailClose">×</button>
      <h3 class="detail-title" id="detail-title"></h3>
      <div class="detail-gallery">
        <button class="detail-prev" aria-label="Previous">❮</button>
        <img id="detail-image" class="detail-image" src="" alt="" />
        <button class="detail-next" aria-label="Next">❯</button>
      </div>
      <div class="detail-counter" id="detail-counter"></div>
      <p class="detail-desc" id="detail-desc"></p>
      <div class="detail-colors" id="detail-colors" style="display:none;">
        <span class="detail-colors-label" data-i18n="products.colorLabel">Цвет чехла:</span>
        <div class="detail-colors-list" id="detail-colors-list"></div>
      </div>
      <div class="detail-bottom">
        <span class="detail-price" id="detail-price"></span>
        <button class="btn btn-cart detail-add" id="detail-add" data-i18n="products.detailAdd">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={`window.productData = ${JSON.stringify(productData)};`} />

<script>
  interface ProductColor {
    id: string;
    hex: string;
    labelKey: string;
  }

  function t(key: string, fallback: string): string {
    if (window.i18n && typeof window.i18n.t === 'function') {
      const translated: string = window.i18n.t(key);
      if (translated && translated !== key) return translated;
    }
    return fallback;
  }

  const productData: ProductDataItem[] = window.productData ?? [];

  document.querySelectorAll<HTMLElement>('.product-card').forEach((card: HTMLElement): void => {
    card.addEventListener('click', (event: MouseEvent): void => {
      const target: EventTarget | null = event.target;
      if (target instanceof Element && target.closest('.btn-cart')) return;
      if (target instanceof Element && target.closest('.details-btn')) return;
      card.classList.toggle('flipped');
    });
    card.addEventListener('keydown', (event: KeyboardEvent): void => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });

  const grid = document.querySelector<HTMLElement>('.products-grid');
  const cards: HTMLElement[] = grid
    ? Array.from(grid.querySelectorAll<HTMLElement>('.product-card'))
    : [];

  function activateCardMask(card: HTMLElement): void {
    const mask = card.dataset.mask;
    if (!mask) return;
    card.style.setProperty('--card-mask', `url("${mask}")`);
    card.classList.add('mask-ready');
  }

  if ('IntersectionObserver' in window) {
    const maskObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const card = entry.target;
        if (!(card instanceof HTMLElement)) return;
        activateCardMask(card);
        maskObserver.unobserve(card);
      });
    }, { rootMargin: '320px 0px' });
    cards.forEach((card) => maskObserver.observe(card));
  } else {
    cards.forEach(activateCardMask);
  }

  const showMoreBtn = document.querySelector<HTMLButtonElement>('#show-more-btn');
  const showMoreParent: HTMLElement | null = showMoreBtn ? showMoreBtn.parentElement : null;

  function getBaseCount(): number {
    return window.innerWidth <= 768 ? 4 : 100;
  }

  let extra: number = 0;

  function applyShowMore(): void {
    if (!showMoreBtn || !showMoreParent) return;
    const show: number = getBaseCount() + extra;
    cards.forEach((card: HTMLElement, index: number): void => {
      card.style.display = index < show ? '' : 'none';
    });
    showMoreParent.style.display = show >= cards.length ? 'none' : 'block';
  }

  if (showMoreBtn && showMoreParent) {
    showMoreBtn.addEventListener('click', (): void => {
      extra += 100;
      applyShowMore();
    });
    let prevWidth: number = window.innerWidth;
    window.addEventListener('resize', (): void => {
      if (Math.floor(prevWidth / 768) !== Math.floor(window.innerWidth / 768)) {
        prevWidth = window.innerWidth;
        extra = 0;
      }
      applyShowMore();
    });
    applyShowMore();
  }

  (function setupDetailModal(): void {
    const modal = document.querySelector<HTMLDivElement>('#detail-modal');
    const modalTitle = document.querySelector<HTMLHeadingElement>('#detail-title');
    const modalImg = document.querySelector<HTMLImageElement>('#detail-image');
    const modalDesc = document.querySelector<HTMLParagraphElement>('#detail-desc');
    const modalPrice = document.querySelector<HTMLSpanElement>('#detail-price');
    const counter = document.querySelector<HTMLDivElement>('#detail-counter');
    const prevBtn = document.querySelector<HTMLButtonElement>('#detail-modal .detail-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('#detail-modal .detail-next');
    const overlay = document.querySelector<HTMLDivElement>('#detail-modal .detail-overlay');
    const closeBtn = document.querySelector<HTMLButtonElement>('#detail-close');
    const addBtn = document.querySelector<HTMLButtonElement>('#detail-add');
    const colorsBlock = document.querySelector<HTMLDivElement>('#detail-colors');
    const colorsList = document.querySelector<HTMLDivElement>('#detail-colors-list');

    if (
      !modal ||
      !modalTitle ||
      !modalImg ||
      !modalDesc ||
      !modalPrice ||
      !counter ||
      !addBtn ||
      !colorsBlock ||
      !colorsList
    ) return;

    const detailModal: HTMLDivElement = modal;
    const detailTitle: HTMLHeadingElement = modalTitle;
    const detailImage: HTMLImageElement = modalImg;
    const detailDescription: HTMLParagraphElement = modalDesc;
    const detailPrice: HTMLSpanElement = modalPrice;
    const detailCounter: HTMLDivElement = counter;
    const detailAdd: HTMLButtonElement = addBtn;
    const detailColors: HTMLDivElement = colorsBlock;
    const detailColorsList: HTMLDivElement = colorsList;

    let currentGallery: string[] = [];
    let currentIndex: number = 0;

    function isProductColor(value: unknown): value is ProductColor {
      if (typeof value !== 'object' || value === null) return false;
      const color = value as Record<string, unknown>;
      return typeof color.id === 'string' &&
        typeof color.hex === 'string' &&
        typeof color.labelKey === 'string';
    }

    function parseProductColors(colorsJson: string): ProductColor[] {
      if (!colorsJson) return [];
      const parsed: unknown = JSON.parse(colorsJson);
      if (!Array.isArray(parsed)) return [];
      const values: unknown[] = parsed;
      const colors: ProductColor[] = [];
      for (const value of values) {
        if (isProductColor(value)) colors.push(value);
      }
      return colors;
    }

    function renderGallery(): void {
      if (!currentGallery.length) return;
      const image: string | undefined = currentGallery[currentIndex];
      if (image === undefined) return;
      detailImage.src = image;
      detailImage.alt = detailTitle.textContent ?? '';
      detailCounter.textContent = `${currentIndex + 1} / ${currentGallery.length}`;
    }

    function openDetail(index: number): void {
      const p: ProductDataItem | undefined = productData[index];
      if (!p) return;
      currentGallery = p.gallery && p.gallery.length ? p.gallery : [p.image];
      currentIndex = 0;

      detailTitle.textContent = t(p.titleKey, p.title);
      detailDescription.textContent = t(p.descKey, p.desc);
      detailPrice.textContent = t(p.priceKey, p.price.toLocaleString('ru-RU') + ' ₽');

      detailAdd.dataset.id = String(p.id);
      detailAdd.dataset.title = p.title;
      detailAdd.dataset.i18nKey = p.i18nKey;
      detailAdd.dataset.price = String(p.price);
      detailAdd.dataset.img = p.image;
      detailAdd.removeAttribute('data-color');

      const colors: ProductColor[] = parseProductColors(p.colorsJson);
      if (colors.length) {
        detailColorsList.innerHTML = '';
        colors.forEach((color: ProductColor): void => {
          const btn: HTMLButtonElement = document.createElement('button');
          btn.type = 'button';
          btn.className = 'detail-color-swatch';
          btn.style.background = color.hex;
          btn.setAttribute('aria-label', t(color.labelKey, color.id));
          btn.title = t(color.labelKey, color.id);
          btn.dataset.colorId = color.id;
          btn.addEventListener('click', (): void => {
            detailAdd.dataset.color = color.id;
            detailAdd.dataset.colorKey = color.labelKey;
            detailColorsList.querySelectorAll<HTMLButtonElement>('.detail-color-swatch').forEach((swatch: HTMLButtonElement): void => {
              swatch.classList.remove('active');
            });
            btn.classList.add('active');
          });
          detailColorsList.appendChild(btn);
        });
        detailColors.style.display = '';
      } else {
        detailColors.style.display = 'none';
      }

      renderGallery();
      detailModal.classList.add('open');
      detailModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function closeDetail(): void {
      detailModal.classList.remove('open');
      detailModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
    window.closeDetailModal = closeDetail;

    document.querySelectorAll<HTMLButtonElement>('.details-btn').forEach((btn: HTMLButtonElement): void => {
      btn.addEventListener('click', (event: MouseEvent): void => {
        event.stopPropagation();
        const details: string | undefined = btn.dataset.details;
        if (details === undefined) return;
        openDetail(Number.parseInt(details, 10));
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', (event: MouseEvent): void => {
        event.stopPropagation();
        if (!currentGallery.length) return;
        currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
        renderGallery();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (event: MouseEvent): void => {
        event.stopPropagation();
        if (!currentGallery.length) return;
        currentIndex = (currentIndex + 1) % currentGallery.length;
        renderGallery();
      });
    }

    if (overlay) overlay.addEventListener('click', closeDetail);
    if (closeBtn) closeBtn.addEventListener('click', closeDetail);

    document.addEventListener('keydown', (event: KeyboardEvent): void => {
      if (event.key === 'Escape' && detailModal.classList.contains('open')) closeDetail();
    });
  })();
</script>

