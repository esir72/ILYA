    short: 'Деревянная маска ручной работы для интерьера или ношения.',
    price: 150000,
    image: productImage(`${base}/images/cards/muxtar/мухтар.webp`, 900, 1224),
    gallery: [
      `${base}/images/cards/muxtar/photo_2026-09-08_13-09-35.webp`,
