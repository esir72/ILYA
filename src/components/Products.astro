---
const products = [
  {
    id: 0,
    title: 'Сумка из дерева',
    desc: 'Ручная работа из натурального дерева. Уникальный дизайн с фактурой древесины.',
    price: 4500,
    image: '/images/sumka-iz-dereva.jpg',
  },
  {
    id: 1,
    title: 'Сумка малая',
    desc: 'Компактная деревянная сумка на каждый день. Лёгкая, прочная, с надёжной фурнитурой.',
    price: 3800,
    image: '/images/sumka-iz-dereva2.jpg',
  },
  {
    id: 2,
    title: 'Кошелёк из дерева',
    desc: 'Оригинальный деревянный кошелёк ручной работы. Вместительный и долговечный.',
    price: 2900,
    image: '/images/koshelek-iz-dereva.jpg',
  },
  {
    id: 3,
    title: 'Картина «Волны»',
    desc: 'Резная картина с морскими волнами из дерева. Авторская работа, подарок в любую коллекцию.',
    price: 5200,
    image: '/images/kartina-volny-golubye-iz-dereva.jpg',
  },
];

const formatPrice = (p) => `${p.toLocaleString('ru-RU')} ₽`;
---

<section class="section" id="products">
  <div class="container">
    <h2 class="section-title" data-animate>Изделия</h2>
    <p class="section-subtitle" data-animate data-delay="1">
      Каждое изделие уникально. Фактура дерева и рисунок могут незначительно 
      отличаться от фото.
    </p>
    <div class="products-grid">
      {products.map((product, i) => (
        <article class="product-card" data-animate="scale" data-delay={i + 1}>
          <div class="product-image">
            <img src={product.image} alt={product.title} loading="lazy" />
          </div>
          <div class="product-info">
            <h3 class="product-title">{product.title}</h3>
            <p class="product-desc">{product.desc}</p>
            <div class="product-bottom">
              <span class="product-price">{formatPrice(product.price)}</span>
              <button class="btn btn-sm btn-cart" data-id={product.id} data-title={product.title} data-price={product.price}>
                В корзину
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-more" data-animate>
      <p>Хотите что-то особенное? Я делаю изделия на заказ.</p>
      <a href="#contact" class="btn">Обсудить заказ</a>
    </div>
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 60px;
  }

  .product-card {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .product-card:hover {
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }

  .product-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--beige);
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-info {
    padding: 24px;
  }

  .product-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .product-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .btn-sm {
    padding: 10px 20px;
    font-size: 0.85rem;
  }

  .products-more {
    text-align: center;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .products-more p {
    color: var(--text-light);
    margin-bottom: 20px;
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .product-info {
      padding: 16px;
    }
    .product-bottom {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
    }
    .product-price {
      text-align: center;
    }
    .btn-sm {
      width: 100%;
    }
  }
</style>
