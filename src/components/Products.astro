---
type ProductColorOption = {
  id: string;
  hex: string;
  labelKey: string;
};

type ProductImage = {
  small: string;
  medium: string;
  large: string;
  width: number;
  height: number;
};

type Product = {
  id: number;
  title: string;
  desc: string;
  short: string;
  price: number;
  image: ProductImage;
  gallery: string[];
  colors?: ProductColorOption[];
};

function productImage(path: string, width: number, height: number): ProductImage {
  return {
    small: path.replace(/(\.[^.]+)$/, '-360$1'),
    medium: path.replace(/(\.[^.]+)$/, '-540$1'),
    large: path,
    width,
    height
  };
}

const base: string = import.meta.env.BASE_URL.replace(/\/$/, '');

const products: Product[] = [
  {
    id: 10,
    title: '«ПЕРВЫЙ СЛЕД» Набор для резьбы по дереву',
    desc: 'Всё необходимое, чтобы сделать первый шаг в древнее ремесло и почувствовать дерево в своих руках.\nВ комплекте: брусок мягкой липы для первого изделия, Богородский нож 50 мм для точной резьбы и ложкорез для глубоких выборок и аккуратных углублений.\nНебольшой набор — чтобы начать резать, создать первое изделие и открыть для себя мир резьбы по дереву.\n\nВсё собрано в подарочной коробке и дополнено тёплым напутствием от Илуи.\nПолностью заточен и готов к работе.\n\nПервый рез. Первое изделие. Первый след, который останется в дереве.',
    short: 'Всё необходимое для первого шага в резьбу: липа, нож и ложкорез.',
    price: 11900,
    image: productImage(`${base}/images/cards/set/set-1.png`, 1254, 1254),
    gallery: [
      `${base}/images/cards/set/photo_2026-09-21_16-18-23.webp`,
      `${base}/images/cards/set/photo_2026-09-21_16-18-31.webp`,
      `${base}/images/cards/set/photo_2026-09-21_16-18-33.webp`
    ],
  },
  {
    id: 9,
    title: 'Универсальный нож',
    desc: 'Инструмент старого ремесла.\nКогда-то человеку было достаточно ножа, куска дерева и собственного воображения, чтобы создавать вещи, которые переживали поколения.\nЭтот нож продолжает ту же традицию.\n90 мм кованой стали, закалённой до 60 HRC, деревянная рукоять и ручная заточка — всё готово для строгания, резьбы и самых разных работ, где нужен точный и послушный инструмент.\nВ комплекте — чехол из натуральной кожи на выбор.\nОн не говорит, что именно вам вырезать.\nОн просто даёт возможность начать или продолжить.',
    short: 'Кованый нож ручной работы с лезвием 90 мм для любых задач.',
    price: 7500,
    colors: [
      { id: 'Черный', hex: '#222222', labelKey: 'colors.black' },
      { id: 'Белый', hex: '#FFFFFF', labelKey: 'colors.white' },
      { id: 'Коричневый', hex: '#8B4513', labelKey: 'colors.brown' }
    ],
    image: productImage(`${base}/images/cards/knife/knife.png`, 1312, 1199),
    gallery: [
      `${base}/images/cards/knife/photo_2026-09-21_16-19-32.webp`,
