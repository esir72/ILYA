      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-30.webp`,
      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-31.webp`,
      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-33.webp`,
    ],
  },
  {
    id: 12,
    title: 'Кукса натуральная маленькая',
    desc: 'Кружка изготовлена вручную из натурального дерева и сочетает традиции древнего ремесла с историческими мотивами. Полностью функциональна — из неё можно пить и использовать в повседневной жизни.',
    short: 'Маленькая деревянная кукса',
    price: 20000,
    image: productImage(`${base}/images/cards/kuksa-malaya/kuksa-malaya.webp`, 900, 794),
    gallery: [
      `${base}/images/cards/kuksa-malaya/photo_2026-09-23_22-08-42.jpg`,
      `${base}/images/cards/kuksa-malaya/photo_2026-09-23_22-08-44.jpg`,
