---
const products = [
  {
    id: 0,
    title: 'Сумка из дерева',
    desc: 'Нож и ложкорез, выкованный из высококачественной «марсианской» стали 9ХС — огнём, потом и традициями наших предков. Проверен поколениями: от каменного века до наших дней. Идеально заточен, готов к работе и режет любое дерево.',
    price: 4500,
    image: '/images/cards/photo_2026-08-12_14-19-01.png',
  },
  {
    id: 1,
    title: 'Сумка малая',
    desc: 'Компактная деревянная сумка на каждый день. Лёгкая, прочная, с надёжной фурнитурой.',
    price: 3800,
    image: '/images/cards/photo_2026-08-12_14-19-08.png',
  },
  {
    id: 2,
    title: 'Кошелёк из дерева',
    desc: 'Оригинальный деревянный кошелёк ручной работы. Вместительный и долговечный.',
    price: 2900,
    image: '/images/cards/photo_2026-08-12_14-19-10-Photoroom.png',
  },
  {
    id: 3,
    title: 'Картина «Волны»',
    desc: 'Резная картина с морскими волнами из дерева. Авторская работа, подарок в любую коллекцию.',
    price: 5200,
    image: '/images/cards/photo_2026-08-12_16-44-54.png',
  },
];

const formatPrice = (p) => `${p.toLocaleString('ru-RU')} ₽`;
---

<section class="section" id="products">
  <div class="container">
    <h2 class="section-title" data-animate data-i18n="products.title">Изделия</h2>
    <p class="section-subtitle" data-animate data-delay="1" data-i18n="products.subtitle">
      Каждое изделие уникально. Фактура дерева и рисунок могут незначительно 
      отличаться от фото.
    </p>
    <div class="products-grid">
      {products.map((product, i) => (
        <article class="product-card" style={`--card-mask: url('${product.image}');`} data-animate="scale" data-delay={i + 1} tabindex="0" role="button">
          <div class="flip-inner">
            <div class="face face-front">
              <div class="flip-front">
                <div class="product-image">
                  <img src={product.image} alt={product.title} loading="lazy" />
                </div>
              </div>
            </div>
            <div class="face face-back">
              <div class="flip-back">
                <div class="flip-back-content">
                  <h3 class="product-title" data-i18n={`products.item.${i}.title`}>{product.title}</h3>
                  <p class="product-desc" data-i18n={`products.item.${i}.desc`}>{product.desc}</p>
                  <div class="product-bottom">
                    <span class="product-price" data-i18n={`products.item.${i}.price`}>{formatPrice(product.price)}</span>
                    <button class="btn btn-sm btn-cart btn-icon-only" data-id={product.id} data-title={product.title} data-i18n-key={`products.item.${i}.title`} data-price={product.price} data-img={product.image} data-i18n-title="products.btnCart" aria-label="В корзину">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="more-photos-wrap">
                    <button class="more-photos-link" data-gallery="['/images/cards/photo_2026-08-12_14-19-01.png','/images/cards/photo_2026-08-12_14-19-08.png','/images/cards/photo_2026-08-12_14-19-10-Photoroom.png','/images/cards/photo_2026-08-12_16-44-54.png']" data-i18n="products.morePhotos">Больше фото</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-more" data-animate>
      <p data-i18n="products.moreText">Хотите что-то особенное? Я делаю изделия на заказ.</p>
      <a href="#payment" class="btn" data-i18n="products.moreBtn">Обсудить заказ</a>
    </div>
  </div>
  <div id="gallery-modal" class="gallery-modal" aria-hidden="true">
    <div class="gallery-overlay"></div>
    <div class="gallery-content">
      <button class="gallery-prev" aria-label="Previous">❮</button>
      <img id="gallery-image" src="" alt="Gallery Image" />
      <button class="gallery-next" aria-label="Next">❯</button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.product-card').forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('.btn-cart')) return;
      card.classList.toggle('flipped');
    });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });

  var modal = document.getElementById('gallery-modal');
  var modalImg = document.getElementById('gallery-image');
  var prevBtn = modal.querySelector('.gallery-prev');
  var nextBtn = modal.querySelector('.gallery-next');
  var overlay = modal.querySelector('.gallery-overlay');
  var currentGallery = [];
  var currentIndex = 0;

  function openGallery(images, startIndex) {
    currentGallery = images;
    currentIndex = startIndex || 0;
    updateGallery();
    modal.classList.add('open');
  }

  function closeGallery() {
    modal.classList.remove('open');
  }

  function updateGallery() {
    modalImg.src = currentGallery[currentIndex];
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
      updateGallery();
    });

    nextBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % currentGallery.length;
      updateGallery();
    });

    overlay.addEventListener('click', closeGallery);

    document.querySelectorAll('.more-photos-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.stopPropagation();
        var images = JSON.parse(link.dataset.gallery.replace(/'/g, '"'));
        openGallery(images, 0);
      });
    });
  }
</script>

<style>
  .more-photos-wrap {
    margin-top: 4px;
  }
  .more-photos-link {
    background: none;
    border: none;
    color: var(--text-light);
    text-decoration: underline;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 4px;
    letter-spacing: 0.03em;
  }
  .more-photos-link:hover {
    color: var(--accent);
  }

  .gallery-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .gallery-modal.open {
    opacity: 1;
    visibility: visible;
  }
  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
  }
  .gallery-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-content img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  .gallery-prev, .gallery-next {
    position: absolute;
    background: rgba(0,0,0,0.5);
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: background 0.2s;
  }
  .gallery-prev:hover, .gallery-next:hover {
    background: var(--accent);
  }
  .gallery-prev {
    left: -20px;
  }
  .gallery-next {
    right: -20px;
  }
  @media (max-width: 768px) {
    .gallery-prev { left: 10px; }
    .gallery-next { right: 10px; }
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 60px;
  }

  .product-card {
    perspective: 1000px;
    cursor: pointer;
    position: relative;
    touch-action: manipulation;
    overflow: clip;
    overflow-clip-margin: 30px;
  }

  .flip-inner {
    position: relative;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-style: preserve-3d;
  }

  .product-card.flipped .flip-inner {
    transform: rotateY(180deg);
  }

  .face-front,
  .face-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .face-front {
    position: relative;
    transform: rotateY(0deg) translateZ(1px);
  }

  .face-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg) translateZ(1px);
  }

  .flip-front,
  .flip-back {
    -webkit-mask-image: var(--card-mask);
    mask-image: var(--card-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .face-front {
      transform: translateY(-8px);
    }

    .product-card:hover .face-back {
      transform: rotateY(180deg) translateY(-8px);
    }

    .flip-front,
    .flip-back {
      transition: filter 0.3s ease;
    }

    .product-card:hover .flip-front,
    .product-card:hover .flip-back {
      filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.45));
    }
  }



  .flip-front {
    position: relative;
  }

  .flip-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
    transition: transform 0.6s;
    transform: translateX(-100%);
    pointer-events: none;
  }

  .product-card:hover .flip-front::after {
    transform: translateX(100%);
  }

  .flip-back {
    position: absolute;
    inset: 0;
    background: var(--surface);
    display: flex;
    align-items: center;
  }

  .flip-back-content {
    width: 100%;
    height: 100%;
    padding: 12%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  /* Специфичный отступ для керамбита (карточка 3) */
  .product-card:nth-child(3) .flip-back-content {
    padding: 22% 14% 12% 10%;
  }

  .product-image {
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 12px;
  }

  .product-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 8px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    overflow-y: auto;
    scrollbar-width: none;
    min-height: 0; /* Ensures flex item can shrink and actually scroll */
  }
  .product-desc::-webkit-scrollbar {
    display: none;
  }

  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .btn-sm {
    padding: 10px 20px;
    font-size: 0.85rem;
  }

  .btn-icon-only {
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .products-more {
    text-align: center;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .products-more p {
    color: var(--text-light);
    margin-bottom: 20px;
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .product-title {
      font-size: 1.05rem;
      margin-bottom: 4px;
    }
    .product-desc {
      font-size: 0.85rem;
      line-height: 1.4;
    }
    .product-bottom {
      flex-direction: row;
      gap: 12px;
      align-items: center;
      justify-content: center;
      margin-top: 4px;
    }
    .product-price {
      text-align: left;
      font-size: 1.1rem;
    }
    .btn-sm.btn-icon-only {
      padding: 10px;
      width: 40px;
      height: 40px;
    }
  }
</style>
