---
const allImages = [
  '/images/cards/photo_2026-08-12_14-19-01.png',
  '/images/cards/photo_2026-08-12_14-19-08.png',
  '/images/cards/photo_2026-08-12_14-19-10-Photoroom.png',
  '/images/cards/photo_2026-08-12_16-44-54.png',
];

const products = [
  {
    id: 0,
    title: 'Сумка из дерева',
    desc: 'Нож и ложкорез, выкованный из высококачественной «марсианской» стали 9ХС — огнём, потом и традициями наших предков. Проверен поколениями: от каменного века до наших дней. Идеально заточен, готов к работе и режет любое дерево.',
    price: 4500,
    image: '/images/cards/photo_2026-08-12_14-19-01.png',
    gallery: allImages,
  },
  {
    id: 1,
    title: 'Сумка малая',
    desc: 'Компактная деревянная сумка на каждый день. Лёгкая, прочная, с надёжной фурнитурой.',
    price: 3800,
    image: '/images/cards/photo_2026-08-12_14-19-08.png',
    gallery: allImages,
  },
  {
    id: 2,
    title: 'Кошелёк из дерева',
    desc: 'Оригинальный деревянный кошелёк ручной работы. Вместительный и долговечный.',
    price: 2900,
    image: '/images/cards/photo_2026-08-12_14-19-10-Photoroom.png',
    gallery: allImages,
  },
  {
    id: 3,
    title: 'Картина «Волны»',
    desc: 'Резная картина с морскими волнами из дерева. Авторская работа, подарок в любую коллекцию.',
    price: 5200,
    image: '/images/cards/photo_2026-08-12_16-44-54.png',
    gallery: allImages,
  },
];

const productData = products.map((p, i) => ({
  id: p.id,
  title: p.title,
  image: p.image,
  price: p.price,
  gallery: p.gallery,
  titleKey: `products.item.${i}.title`,
  descKey: `products.item.${i}.desc`,
  i18nKey: `products.item.${i}.title`,
}));

const formatPrice = (p) => `${p.toLocaleString('ru-RU')} ₽`;
---

<section class="section" id="products">
  <div class="container">
    <h2 class="section-title" data-animate data-i18n="products.title">Изделия</h2>
    <p class="section-subtitle" data-animate data-delay="1" data-i18n="products.subtitle">
      Каждое изделие уникально. Фактура дерева и рисунок могут незначительно
      отличаться от фото.
    </p>
    <div class="products-grid">
      {products.map((product, i) => (
        <article class="product-card" style={`--card-mask: url('${product.image}');`} data-animate="scale" data-delay={i + 1} tabindex="0" role="button">
          <div class="flip-inner">
            <div class="face face-front">
              <div class="flip-front">
                <div class="product-image">
                  <img src={product.image} alt={product.title} loading="lazy" />
                </div>
              </div>
            </div>
            <div class="face face-back">
              <div class="flip-back">
                <div class="flip-back-content">
                  <h3 class="product-title" data-i18n={`products.item.${i}.title`}>{product.title}</h3>
                  <p class="product-desc" data-i18n={`products.item.${i}.desc`}>{product.desc}</p>
                  <div class="product-bottom">
                    <span class="product-price" data-i18n={`products.item.${i}.price`}>{formatPrice(product.price)}</span>
                    <button class="btn btn-sm btn-cart btn-icon-only" data-id={product.id} data-title={product.title} data-i18n-key={`products.item.${i}.title`} data-price={product.price} data-img={product.image} data-i18n-title="products.btnCart" aria-label="В корзину">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="product-back-actions">
                    <button class="details-btn" data-details={i} data-i18n="products.details">Подробнее</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-more" data-animate>
      <p data-i18n="products.moreText">Хотите что-то особенное? Я делаю изделия на заказ.</p>
      <a href="#payment" class="btn" data-i18n="products.moreBtn">Обсудить заказ</a>
    </div>
  </div>

  <div id="detail-modal" class="detail-modal" aria-hidden="true">
    <div class="detail-overlay"></div>
    <div class="detail-content" role="dialog" aria-modal="true">
      <button class="detail-close" id="detail-close" aria-label="Закрыть" data-i18n-aria="products.detailClose">×</button>
      <h3 class="detail-title" id="detail-title"></h3>
      <div class="detail-gallery">
        <button class="detail-prev" aria-label="Previous">❮</button>
        <img id="detail-image" class="detail-image" src="" alt="" />
        <button class="detail-next" aria-label="Next">❯</button>
      </div>
      <div class="detail-counter" id="detail-counter"></div>
      <p class="detail-desc" id="detail-desc"></p>
      <div class="detail-bottom">
        <span class="detail-price" id="detail-price"></span>
        <button class="btn btn-cart detail-add" id="detail-add" data-i18n="products.detailAdd">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ productData }}>
  function t(key, fallback) {
    if (window.i18n && typeof window.i18n.t === 'function') {
      var v = window.i18n.t(key);
      if (v && v !== key) return v;
    }
    return fallback;
  }

  document.querySelectorAll('.product-card').forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('.btn-cart')) return;
      if (e.target.closest('.details-btn')) return;
      card.classList.toggle('flipped');
    });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });

  var modal = document.getElementById('detail-modal');
  var modalTitle = document.getElementById('detail-title');
  var modalImg = document.getElementById('detail-image');
  var modalDesc = document.getElementById('detail-desc');
  var modalPrice = document.getElementById('detail-price');
  var counter = document.getElementById('detail-counter');
  var prevBtn = modal.querySelector('.detail-prev');
  var nextBtn = modal.querySelector('.detail-next');
  var overlay = modal.querySelector('.detail-overlay');
  var closeBtn = document.getElementById('detail-close');
  var addBtn = document.getElementById('detail-add');

  var currentGallery = [];
  var currentIndex = 0;
  var currentProduct = null;

  function renderGallery() {
    if (!currentGallery.length) return;
    modalImg.src = currentGallery[currentIndex];
    modalImg.alt = modalTitle.textContent;
    counter.textContent = (currentIndex + 1) + ' / ' + currentGallery.length;
  }

  function openDetail(index) {
    var p = productData[index];
    if (!p) return;
    currentProduct = p;
    currentGallery = p.gallery && p.gallery.length ? p.gallery : [p.image];
    currentIndex = 0;

    modalTitle.textContent = t(p.titleKey, p.title);
    modalDesc.textContent = t(p.descKey, p.desc);
    modalPrice.textContent = p.price.toLocaleString('ru-RU') + ' ₽';

    addBtn.dataset.id = p.id;
    addBtn.dataset.title = p.title;
    addBtn.dataset.i18nKey = p.i18nKey;
    addBtn.dataset.price = p.price;
    addBtn.dataset.img = p.image;

    renderGallery();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDetail() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.details-btn').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      openDetail(parseInt(btn.dataset.details, 10));
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
      renderGallery();
    });
    nextBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % currentGallery.length;
      renderGallery();
    });
    overlay.addEventListener('click', closeDetail);
    closeBtn.addEventListener('click', closeDetail);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeDetail();
    });
  }
</script>

<style>
  .product-back-actions {
    margin-top: 8px;
  }
  .details-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 8px 18px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .details-btn:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .detail-modal {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .detail-modal.open {
    opacity: 1;
    visibility: visible;
  }
  .detail-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
  }
  .detail-content {
    position: relative;
    z-index: 1101;
    width: min(90vw, 560px);
    max-height: 90vh;
    overflow-y: auto;
    background: var(--surface);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    scrollbar-width: none;
  }
  .detail-content::-webkit-scrollbar {
    display: none;
  }
  .detail-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--bg);
    border: none;
    color: var(--text);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .detail-close:hover {
    background: var(--accent);
    color: #fff;
  }
  .detail-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: 16px;
    padding-right: 40px;
  }
  .detail-gallery {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border-radius: 12px;
    padding: 12px;
  }
  .detail-image {
    max-width: 100%;
    max-height: 56vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .detail-counter {
    text-align: center;
    color: var(--text-light);
    font-size: 0.85rem;
    margin-top: 8px;
  }
  .detail-prev, .detail-next {
    position: absolute;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: background 0.2s;
  }
  .detail-prev:hover, .detail-next:hover {
    background: var(--accent);
  }
  .detail-prev { left: 8px; }
  .detail-next { right: 8px; }
  .detail-desc {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-light);
    margin: 16px 0 20px;
  }
  .detail-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  .detail-price {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent);
    font-family: var(--font-heading);
  }
  .btn-cart.detail-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 12px 22px;
    gap: 8px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 60px;
  }

  .product-card {
    perspective: 1000px;
    cursor: pointer;
    position: relative;
    touch-action: manipulation;
    overflow: clip;
    overflow-clip-margin: 30px;
  }

  .flip-inner {
    position: relative;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-style: preserve-3d;
  }

  .product-card.flipped .flip-inner {
    transform: rotateY(180deg);
  }

  .face-front,
  .face-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .face-front {
    position: relative;
    transform: rotateY(0deg) translateZ(1px);
  }

  .face-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg) translateZ(1px);
  }

  .flip-front,
  .flip-back {
    -webkit-mask-image: var(--card-mask);
    mask-image: var(--card-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .face-front {
      transform: translateY(-8px);
    }

    .product-card:hover .face-back {
      transform: rotateY(180deg) translateY(-8px);
    }

    .flip-front,
    .flip-back {
      transition: filter 0.3s ease;
    }

    .product-card:hover .flip-front,
    .product-card:hover .flip-back {
      filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.45));
    }
  }



  .flip-front {
    position: relative;
  }

  .flip-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
    transition: transform 0.6s;
    transform: translateX(-100%);
    pointer-events: none;
  }

  .product-card:hover .flip-front::after {
    transform: translateX(100%);
  }

  .flip-back {
    position: absolute;
    inset: 0;
    background: var(--surface);
    display: flex;
    align-items: center;
  }

  .flip-back-content {
    width: 100%;
    height: 100%;
    padding: 12%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  /* Специфичный отступ для керамбита (карточка 3) */
  .product-card:nth-child(3) .flip-back-content {
    padding: 22% 14% 12% 10%;
  }

  .product-image {
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 12px;
  }

  .product-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 8px;
    line-height: 1.5;
    overflow-y: auto;
    scrollbar-width: none;
    min-height: 0; /* Ensures flex item can shrink and actually scroll */
  }
  .product-desc::-webkit-scrollbar {
    display: none;
  }

  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .btn-sm {
    padding: 10px 20px;
    font-size: 0.85rem;
  }

  .btn-icon-only {
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .products-more {
    text-align: center;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .products-more p {
    color: var(--text-light);
    margin-bottom: 20px;
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .product-title {
      font-size: 1.05rem;
      margin-bottom: 4px;
    }
    .product-desc {
      font-size: 0.85rem;
      line-height: 1.4;
    }
    .product-bottom {
      flex-direction: row;
      gap: 12px;
      align-items: center;
      justify-content: center;
      margin-top: 4px;
    }
    .product-price {
      text-align: left;
      font-size: 1.1rem;
    }
    .btn-sm.btn-icon-only {
      padding: 10px;
      width: 40px;
      height: 40px;
    }
    .detail-content {
      padding: 20px;
    }
    .detail-title {
      font-size: 1.25rem;
    }
    .detail-price {
      font-size: 1.2rem;
    }
  }
</style>
