---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allImages = [
  `${base}/images/cards/photo_2026-08-12_14-19-01.png`,
  `${base}/images/cards/photo_2026-08-12_14-19-08.png`,
  `${base}/images/cards/photo_2026-08-12_14-19-10-Photoroom.png`,
  `${base}/images/cards/photo_2026-08-12_16-44-54.png`,
];

const products = [
  {
    id: 0,
    title: 'Нож и ложкорез',
    desc: 'Нож и ложкорез, выкованный из высококачественной «марсианской» стали 9ХС — огнём, потом и традициями наших предков. Проверен поколениями: от каменного века до наших дней. Идеально заточен, готов к работе и режет любое дерево.',
    short: 'Нож и ложкорез ручной работы из «марсианской» стали 9ХС.',
    price: 4500,
    image: `${base}/images/cards/photo_2026-08-12_14-19-01.png`,
    gallery: allImages,
    colors: [
      { id: 'black', hex: '#1a1a1a', labelKey: 'products.colorBlack' },
      { id: 'beige', hex: '#d4c5a9', labelKey: 'products.colorBeige' },
      { id: 'blue', hex: '#4a6fa5', labelKey: 'products.colorBlue' },
    ],
  },
  {
    id: 1,
    title: 'Картина «Волны»',
    desc: 'Волны, вырезанные вручную из цельного массива дерева — с душой и любовью к морю. Они передают его красоту, силу и бесконечность. Ведь на небесах говорят только о море. А кто на море не был — тот лох.',
    short: 'Резная картина с морскими волнами из дерева.',
    price: 3800,
    image: `${base}/images/cards/photo_2026-08-12_14-19-08.png`,
    gallery: allImages,
  },
  {
    id: 2,
    title: 'Деревянный керамбит',
    desc: 'Доисторический керамбит — идеальный нож из цельного куска дерева, созданный задолго до появления Counter-Strike. Когда-то о таком оружии только мечтали, а сегодня этот редкий артефакт продолжает жить, передаваясь из поколения в поколение вместе с древними традициями обработки дерева.',
    short: 'Доисторический деревянный керамбит.',
    price: 2900,
    image: `${base}/images/cards/photo_2026-08-12_14-19-10-Photoroom.png`,
    gallery: allImages,
  },
  {
    id: 3,
    title: 'Рунический оберег',
    desc: 'Девять дней и девять ночей висел Один, пронзённый копьём, чтобы добыть для людей мудрость и тайну рун. Этот оберег — дань его подвигу: вырезан вручную из дерева, в нём переплелись древние символы, сила предков и дух северных богов. От кроманьонца до современного человека — знания меняются, но руны остаются.',
    short: 'Рунический оберег ручной работы из дерева.',
    price: 5200,
    image: `${base}/images/cards/photo_2026-08-12_16-44-54.png`,
    gallery: allImages,
  },
  {
    id: 4,
    title: 'Кукса большая',
    desc: 'Большая кукса, созданная для неспешного наслаждения любимыми напитками. Вырезана вручную с душой, сохраняя дух и традиции древних мастеров.\n\nЕё форма и сам принцип изготовления уходят корнями в глубокую историю — подобные деревянные сосуды люди создавали и использовали ещё много веков назад.\n\nЭто не просто кружка, а вещь с историей, выполненная в традиционном стиле и полностью готовая к использованию. Идеальна для воды, чая, кофе и других любимых напитков.',
    short: 'Большая деревянная кукса',
    price: 28000,
    image: `${base}/images/cards/kuksa/kuksa-mask.png`,
    mask: `${base}/images/cards/kuksa/kuksa-mask.png`,
    gallery: [
      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-30.jpg`,
      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-31.jpg`,
      `${base}/images/cards/kuksa/photo_2026-08-24_11-41-33.jpg`,
    ],
  },
];

const productData = products.map((p, i) => ({
  id: p.id,
  title: p.title,
  image: p.image,
  price: p.price,
  gallery: p.gallery,
  colorsJson: p.colors ? JSON.stringify(p.colors) : '',
  titleKey: `products.item.${i}.title`,
  descKey: `products.item.${i}.desc`,
  priceKey: `products.item.${i}.price`,
  i18nKey: `products.item.${i}.title`,
}));

const formatPrice = (p) => `${p.toLocaleString('ru-RU')} ₽`;
---

<section class="section" id="products">
  <div class="container">
    <h2 class="section-title" data-animate data-i18n="products.title">Изделия</h2>
    <p class="section-subtitle" data-animate data-delay="1" data-i18n="products.subtitle">
      Каждое изделие уникально. Фактура дерева и рисунок могут незначительно
      отличаться от фото.
    </p>
    <div class="products-grid">
      {products.map((product, i) => (
        <article class="product-card" style={`--card-mask: url('${product.mask || product.image}');`} data-animate="scale" data-delay={i + 1} tabindex="0" role="button">
          <div class="flip-inner">
            <div class="face face-front">
              <div class="flip-front">
                <div class="product-image">
                  <img src={product.image} alt={product.title} loading="lazy" />
                </div>
              </div>
            </div>
            <div class="face face-back">
              <div class="flip-back">
                <div class="flip-back-content">
                  <h3 class="product-title" data-i18n={`products.item.${i}.title`}>{product.title}</h3>
                  <p class="product-desc" data-i18n={`products.item.${i}.short`}>{product.short}</p>
                  <div class="product-bottom">
                    <span class="product-price" data-i18n={`products.item.${i}.price`}>{formatPrice(product.price)}</span>
                    <button class="btn btn-sm btn-cart btn-icon-only" data-id={product.id} data-title={product.title} data-i18n-key={`products.item.${i}.title`} data-price={product.price} data-img={product.image} data-i18n-title="products.btnCart" aria-label="В корзину">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="product-back-actions">
                    <button class="details-btn" data-details={i} data-i18n="products.details">Подробнее</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-showmore">
      <button id="show-more-btn" class="btn" data-i18n="products.showMore">Показать еще</button>
    </div>
    <div class="products-more" data-animate>
      <p data-i18n="products.moreText">Хотите что-то особенное? Я делаю изделия на заказ.</p>
      <a href="#payment" class="btn" data-i18n="products.moreBtn">Обсудить заказ</a>
    </div>
  </div>

  <div id="detail-modal" class="detail-modal" aria-hidden="true">
    <div class="detail-overlay"></div>
    <div class="detail-content" role="dialog" aria-modal="true">
      <button class="detail-close" id="detail-close" aria-label="Закрыть" data-i18n-aria="products.detailClose">×</button>
      <h3 class="detail-title" id="detail-title"></h3>
      <div class="detail-gallery">
        <button class="detail-prev" aria-label="Previous">❮</button>
        <img id="detail-image" class="detail-image" src="" alt="" />
        <button class="detail-next" aria-label="Next">❯</button>
      </div>
      <div class="detail-counter" id="detail-counter"></div>
      <p class="detail-desc" id="detail-desc"></p>
      <div class="detail-colors" id="detail-colors" style="display:none;">
        <span class="detail-colors-label" data-i18n="products.colorLabel">Цвет чехла:</span>
        <div class="detail-colors-list" id="detail-colors-list"></div>
      </div>
      <div class="detail-bottom">
        <span class="detail-price" id="detail-price"></span>
        <button class="btn btn-cart detail-add" id="detail-add" data-i18n="products.detailAdd">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={`window.productData = ${JSON.stringify(productData)};`} />

<script>
  function t(key, fallback) {
    if (window.i18n && typeof window.i18n.t === 'function') {
      var v = window.i18n.t(key);
      if (v && v !== key) return v;
    }
    return fallback;
  }

  var productData = window.productData || [];

  document.querySelectorAll('.product-card').forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('.btn-cart')) return;
      if (e.target.closest('.details-btn')) return;
      card.classList.toggle('flipped');
    });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });

  var grid = document.querySelector('.products-grid');
  var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.product-card')) : [];
  var showMoreBtn = document.getElementById('show-more-btn');

  function getColumns() {
    return window.innerWidth <= 768 ? 1 : 3;
  }

  var extra = 0;

  function applyShowMore() {
    if (!showMoreBtn) return;
    var base = 4 * getColumns();
    var show = base + extra;
    cards.forEach(function (card, i) {
      card.style.display = i < show ? '' : 'none';
    });
    showMoreBtn.parentElement.style.display = show >= cards.length ? 'none' : 'block';
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', function () {
      extra += 4 * getColumns();
      applyShowMore();
    });
    var prevWidth = window.innerWidth;
    window.addEventListener('resize', function () {
      if (Math.floor(prevWidth / 768) !== Math.floor(window.innerWidth / 768)) {
        prevWidth = window.innerWidth;
        extra = 0;
      }
      applyShowMore();
    });
    applyShowMore();
  }

  var modal = document.getElementById('detail-modal');
  var modalTitle = document.getElementById('detail-title');
  var modalImg = document.getElementById('detail-image');
  var modalDesc = document.getElementById('detail-desc');
  var modalPrice = document.getElementById('detail-price');
  var counter = document.getElementById('detail-counter');
  var prevBtn = modal.querySelector('.detail-prev');
  var nextBtn = modal.querySelector('.detail-next');
  var overlay = modal.querySelector('.detail-overlay');
  var closeBtn = document.getElementById('detail-close');
  var addBtn = document.getElementById('detail-add');
  var colorsBlock = document.getElementById('detail-colors');
  var colorsList = document.getElementById('detail-colors-list');

  var currentGallery = [];
  var currentIndex = 0;
  var currentProduct = null;
  var selectedColor = null;

  function renderGallery() {
    if (!currentGallery.length) return;
    modalImg.src = currentGallery[currentIndex];
    modalImg.alt = modalTitle.textContent;
    counter.textContent = (currentIndex + 1) + ' / ' + currentGallery.length;
  }

  function openDetail(index) {
    var p = productData[index];
    if (!p) return;
    currentProduct = p;
    currentGallery = p.gallery && p.gallery.length ? p.gallery : [p.image];
    currentIndex = 0;
    selectedColor = null;

    modalTitle.textContent = t(p.titleKey, p.title);
    modalDesc.textContent = t(p.descKey, p.desc);
    modalPrice.textContent = t(p.priceKey, p.price.toLocaleString('ru-RU') + ' ₽');

    addBtn.dataset.id = p.id;
    addBtn.dataset.title = p.title;
    addBtn.dataset.i18nKey = p.i18nKey;
    addBtn.dataset.price = p.price;
    addBtn.dataset.img = p.image;
    delete addBtn.dataset.color;

    var colors = p.colorsJson ? JSON.parse(p.colorsJson) : null;
    if (colors && colors.length) {
      colorsList.innerHTML = '';
      colors.forEach(function (c) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'detail-color-swatch';
        btn.style.background = c.hex;
        btn.setAttribute('aria-label', t(c.labelKey, c.id));
        btn.title = t(c.labelKey, c.id);
        btn.dataset.colorId = c.id;
        btn.addEventListener('click', function () {
          selectedColor = c.id;
          addBtn.dataset.color = c.id;
          colorsList.querySelectorAll('.detail-color-swatch').forEach(function (s) { s.classList.remove('active'); });
          btn.classList.add('active');
        });
        colorsList.appendChild(btn);
      });
      colorsBlock.style.display = '';
    } else {
      colorsBlock.style.display = 'none';
    }

    renderGallery();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
  }

  function closeDetail() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  }

  document.querySelectorAll('.details-btn').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      openDetail(parseInt(btn.dataset.details, 10));
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
      renderGallery();
    });
    nextBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % currentGallery.length;
      renderGallery();
    });
    overlay.addEventListener('click', closeDetail);
    closeBtn.addEventListener('click', closeDetail);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeDetail();
    });
  }

  addBtn.addEventListener('click', function (e) {
    // Проверка цвета теперь выполняется в обработчике btn-cart в Layout.astro
  });
</script>

<style>
  .product-back-actions {
    margin-top: 8px;
  }
  .details-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 8px 18px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .details-btn:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .detail-modal {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 24px;
  }
  .detail-modal.open {
    opacity: 1;
    visibility: visible;
  }
  .detail-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  .detail-content {
    position: relative;
    z-index: 1101;
    width: min(92vw, 720px);
    margin: auto;
    background: transparent;
    border-radius: 16px;
    padding: 28px;
    scrollbar-width: none;
  }
  .detail-content::-webkit-scrollbar {
    display: none;
  }
  .detail-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1102;
    background: var(--bg);
    border: none;
    color: var(--text);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .detail-close:hover {
    background: var(--accent);
    color: #fff;
  }
  .detail-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: 16px;
    padding-right: 40px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }
  .detail-desc,
  .detail-counter {
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  .detail-gallery {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 12px;
    padding: 12px;
  }
  .detail-image {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .detail-counter {
    text-align: center;
    color: var(--text-light);
    font-size: 0.85rem;
    margin-top: 8px;
  }
  .detail-prev, .detail-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1102;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    transition: background 0.2s;
  }
  .detail-prev:hover, .detail-next:hover {
    background: var(--accent);
  }
  .detail-prev { left: 14px; }
  .detail-next { right: 14px; }
  .detail-desc {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-light);
    margin: 16px 0 20px;
    white-space: pre-line;
  }
  .detail-colors {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .detail-colors-label {
    font-size: 0.9rem;
    color: var(--text-light);
    flex-shrink: 0;
  }
  .detail-colors-list {
    display: flex;
    gap: 10px;
  }
  :global(.detail-color-swatch) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.2s;
    outline: none;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.15), 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  :global(.detail-color-swatch:hover) {
    transform: scale(1.15);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.2), 0 4px 10px rgba(0, 0, 0, 0.25);
  }
  :global(.detail-color-swatch.active) {
    transform: scale(1.15);
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--accent), 0 4px 10px rgba(0, 0, 0, 0.3);
  }
  .detail-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  .detail-price {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent);
    font-family: var(--font-heading);
  }
  .btn-cart.detail-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 12px 22px;
    gap: 8px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 60px;
  }

  .product-card {
    perspective: 1000px;
    cursor: pointer;
    position: relative;
    touch-action: manipulation;
    overflow: clip;
    overflow-clip-margin: 30px;
  }

  .flip-inner {
    position: relative;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-style: preserve-3d;
  }

  .product-card.flipped .flip-inner {
    transform: rotateY(180deg);
  }

  .face-front,
  .face-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .face-front {
    position: relative;
    transform: rotateY(0deg) translateZ(1px);
  }

  .face-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg) translateZ(1px);
  }

  .flip-front,
  .flip-back {
    -webkit-mask-image: var(--card-mask);
    mask-image: var(--card-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .face-front {
      transform: translateY(-8px);
    }

    .product-card:hover .face-back {
      transform: rotateY(180deg) translateY(-8px);
    }

    .flip-front,
    .flip-back {
      transition: filter 0.3s ease;
    }

    .product-card:hover .flip-front,
    .product-card:hover .flip-back {
      filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.45));
    }
  }



  .flip-front {
    position: relative;
  }

  .flip-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
    transition: transform 0.6s;
    transform: translateX(-100%);
    pointer-events: none;
  }

  .product-card:hover .flip-front::after {
    transform: translateX(100%);
  }

  .flip-back {
    position: absolute;
    inset: 0;
    background: var(--surface);
    display: flex;
    align-items: center;
  }

  .flip-back-content {
    width: 100%;
    height: 100%;
    padding: 12%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
