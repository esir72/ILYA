---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const slides = [
  {
    image: `${base}/images/cards/set/set-1.png`,
    width: 1254,
    height: 1254,
    shortTitle: '«ПЕРВЫЙ СЛЕД» Набор для резьбы',
    shortDesc: 'Липа, Богородский нож и ложкорез — всё, чтобы начать резать.',
    fullTitle: 'Набор для резьбы по дереву «Первый след»',
    fullDesc: 'Всё необходимое, чтобы сделать первый шаг в древнее ремесло: брусок мягкой липы для первого изделия, Богородский нож 50 мм для точной резьбы и ложкорез для глубоких выборок. Полностью заточен, собран в подарочной коробке и готов к работе.',
    shortTitleKey: 'tools.slide.0.shortTitle',
    shortDescKey: 'tools.slide.0.shortDesc',
    fullTitleKey: 'tools.slide.0.fullTitle',
    fullDescKey: 'tools.slide.0.fullDesc',
    imageAltKey: 'tools.slide.0.imageAlt'
  },
  {
    image: `${base}/images/cards/knife/knife.webp`,
    width: 900,
    height: 959,
    shortTitle: 'Универсальный нож',
    shortDesc: 'Кованый нож 90 мм с деревянной рукоятью.',
    fullTitle: 'Универсальный нож',
    fullDesc: 'Инструмент старого ремесла: 90 мм кованой стали, закалённой до 60 HRC, деревянная рукоять и ручная заточка. Для строгания, резьбы и любых работ, где нужен точный и послушный инструмент.',
    shortTitleKey: 'tools.slide.1.shortTitle',
    shortDescKey: 'tools.slide.1.shortDesc',
    fullTitleKey: 'tools.slide.1.fullTitle',
    fullDescKey: 'tools.slide.1.fullDesc',
    imageAltKey: 'tools.slide.1.imageAlt'
  },
  {
    image: `${base}/images/cards/wawes/wawes.webp`,
    width: 900,
    height: 982,
    shortTitle: 'Картина «Волны»',
    shortDesc: 'Резная картина с морскими волнами.',
    fullTitle: 'Картина «Волны»',
    fullDesc: 'Авторская работа из дерева. Глубина и текстура дерева передают движение волн.',
    shortTitleKey: 'tools.slide.2.shortTitle',
    shortDescKey: 'tools.slide.2.shortDesc',
    fullTitleKey: 'tools.slide.2.fullTitle',
    fullDescKey: 'tools.slide.2.fullDesc',
    imageAltKey: 'tools.slide.2.imageAlt'
  },
  {
    image: `${base}/images/cards/polirovka/polirovka.png`,
    width: 1448,
    height: 1086,
    shortTitle: 'Набор для полировки',
    shortDesc: 'Кожаная плита и паста, чтобы нож и ложкорез всегда были острыми.',
    fullTitle: 'Набор для полировки и правки инструмента',
    fullDesc: 'Всё, чтобы поддерживать остроту ножей, ложкорезов и стамесок: нанесите немного полировальной пасты на кожаную поверхность — и режущая кромка снова станет чистой и острой.',
    shortTitleKey: 'tools.slide.3.shortTitle',
    shortDescKey: 'tools.slide.3.shortDesc',
    fullTitleKey: 'tools.slide.3.fullTitle',
    fullDescKey: 'tools.slide.3.fullDesc',
    imageAltKey: 'tools.slide.3.imageAlt'
  }
];
---

<section class="tools-carousel" id="tools" data-animate="fade">
  <div class="carousel-container">
    <div class="carousel-track" id="carousel-track">
      {slides.map((slide, i) => (
        <div class="carousel-slide" data-index={i}>
             <img src={slide.image} width={slide.width} height={slide.height} alt={slide.shortTitle} class="carousel-bg" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" data-i18n-aria={slide.imageAltKey} />
            <div class="carousel-overlay"></div>
            <div class="carousel-content">
              <p class="carousel-label" data-i18n="tools.label">Инструменты</p>
              <h2 class="carousel-short-title" data-i18n={slide.shortTitleKey}>{slide.shortTitle}</h2>
              <p class="carousel-short-desc" data-i18n={slide.shortDescKey}>{slide.shortDesc}</p>
              <div class="carousel-full">
                <h2 class="carousel-full-title" data-i18n={slide.fullTitleKey}>{slide.fullTitle}</h2>
                <p class="carousel-full-desc" data-i18n={slide.fullDescKey}>{slide.fullDesc}</p>
            </div>
            <button class="carousel-toggle-btn" data-i18n="tools.expand">Подробнее</button>
          </div>
        </div>
      ))}
    </div>
    <button class="carousel-arrow carousel-prev" id="carousel-prev" aria-label="Назад" data-i18n-aria="tools.ariaPrev">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="carousel-arrow carousel-next" id="carousel-next" aria-label="Вперёд" data-i18n-aria="tools.ariaNext">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="carousel-dots" id="carousel-dots">
      {slides.map((_, i) => (
        <button class="carousel-dot" data-slide={i} aria-label={`Слайд ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.querySelector<HTMLElement>('#carousel-track');
    const prevBtn = document.querySelector<HTMLButtonElement>('#carousel-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('#carousel-next');
    if (!track || !prevBtn || !nextBtn) return;

    const carouselTrack: HTMLElement = track;
    const carouselPrev: HTMLButtonElement = prevBtn;
    const carouselNext: HTMLButtonElement = nextBtn;
    const slides = Array.from(carouselTrack.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
    let current = 0;

    function goTo(index: number): void {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      current = index;
      carouselTrack.style.transform = 'translateX(-' + current * 100 + '%)';
      dots.forEach(function (d, i) {
        d.classList.toggle('active', i === current);
      });
      // collapse all slides
      slides.forEach(function (s) { s.classList.remove('expanded'); });
      updateToggleText();
    }

    function getToggleBtn(slide: HTMLElement): HTMLButtonElement | null {
      return slide.querySelector<HTMLButtonElement>('.carousel-toggle-btn');
    }

    function updateToggleText(): void {
      slides.forEach(function (s) {
        const btn = getToggleBtn(s);
        if (!btn) return;
        if (window.i18n && window.i18n.loaded) {
          btn.textContent = s.classList.contains('expanded')
            ? window.i18n.t('tools.collapse')
            : window.i18n.t('tools.expand');
        } else {
          btn.textContent = s.classList.contains('expanded') ? 'Свернуть' : 'Подробнее';
        }
      });
    }

    function slideAriaLabel(i: number): string {
      const base = (window.i18n && window.i18n.loaded)
        ? (window.i18n.t('tools.ariaSlide') || 'Слайд')
        : ((window.i18n && window.i18n.lang === 'en') ? 'Slide' : 'Слайд');
      return base + ' ' + (i + 1);
    }

    function updateDotsAria(): void {
      dots.forEach(function (d, i) {
        d.setAttribute('aria-label', slideAriaLabel(i));
      });
    }

    updateDotsAria();
    document.addEventListener('langchange', updateDotsAria);

    carouselPrev.addEventListener('click', function () { goTo(current - 1); });
    carouselNext.addEventListener('click', function () { goTo(current + 1); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        const rawIndex = dot.dataset.slide;
        if (rawIndex === undefined) return;
        const index = parseInt(rawIndex, 10);
        if (Number.isNaN(index)) return;
        goTo(index);
      });
    });

    slides.forEach(function (slide) {
      const btn = getToggleBtn(slide);
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        slide.classList.toggle('expanded');
        updateToggleText();
      });
    });

    // keyboard
    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });

    goTo(0);
  })();
</script>

<style>
  .tools-carousel {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
  }

  .carousel-container {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-slide {
    min-width: 100%;
    position: relative;
    height: 70vh;
    min-height: 400px;
    max-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .carousel-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.1) 100%);
  }

  .carousel-content {
    position: relative;
    z-index: 1;
    padding: 48px;
    max-width: 600px;
    color: #fff;
  }

  .carousel-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .carousel-short-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 400;
    margin-bottom: 12px;
  }

  .carousel-short-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
  }

  .carousel-full {
    display: none;
    margin-top: 16px;
  }

  .carousel-slide.expanded .carousel-short-title,
  .carousel-slide.expanded .carousel-short-desc {
    display: none;
  }

  .carousel-slide.expanded .carousel-full {
    display: block;
  }

  .carousel-full-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 12px;
  }

  .carousel-full-desc {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
  }

  .carousel-toggle-btn {
    display: inline-block;
    margin-top: 24px;
    padding: 12px 28px;
    background: var(--accent-fill);
    color: #fff;
    border: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.25s;
  }

  .carousel-toggle-btn:hover {
    background: var(--accent-fill-light);
  }

  /* arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border: none;
    background: rgba(0,0,0,0.4);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .carousel-arrow:hover {
    background: rgba(0,0,0,0.7);
  }

  .carousel-prev { left: 16px; }
  .carousel-next { right: 16px; }

  /* dots */
  .carousel-dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 10px;
  }

  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.6);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, border-color 0.2s;
  }

  .carousel-dot.active {
    background: var(--accent);
    border-color: var(--accent);
  }

  .carousel-dot:hover {
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .carousel-slide {
      height: 60vh;
      min-height: 360px;
    }
    .carousel-content {
      padding: 32px;
    }
    .carousel-short-title {
      font-size: 1.8rem;
    }
    .carousel-full-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .carousel-slide {
      height: 55vh;
      min-height: 320px;
    }
    .carousel-content {
      padding: 24px;
    }
    .carousel-short-title {
      font-size: 1.4rem;
    }
    .carousel-short-desc {
      font-size: 0.9rem;
    }
    .carousel-full-title {
      font-size: 1.2rem;
    }
    .carousel-full-desc {
      font-size: 0.9rem;
    }
    .carousel-arrow {
      width: 36px;
      height: 36px;
    }
    .carousel-prev { left: 8px; }
    .carousel-next { right: 8px; }
    .carousel-dots {
      bottom: 16px;
    }
  }
</style>
