---
const tool = {
  title: 'Набор резцов для резьбы по дереву',
  desc: 'Собственноручно изготовленный набор из трёх резцов. Сталь У8, ручки — кап берёзы.',
  price: 3800,
  image: '/images/10 Mind-Blowing Wood Carving Techniques You Need To Try Today! - The Table Read Magazine.jpg',
};
---

<a href="/tool" class="tool-banner" data-animate="fade">
  <div class="tool-bg">
    <img src={tool.image} alt="" />
  </div>
  <div class="tool-overlay"></div>
  <div class="container tool-content">
    <p class="tool-label">Инструменты</p>
    <h2 class="tool-title">{tool.title}</h2>
    <p class="tool-desc">{tool.desc}</p>
    <span class="tool-link">Подробнее →</span>
  </div>
</a>

<style>
  .tool-banner {
    position: relative;
    display: block;
    height: 80vh;
    min-height: 400px;
    max-height: 600px;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }

  .tool-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .tool-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .tool-banner:hover .tool-bg img {
    transform: scale(1.05);
  }

  .tool-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.15) 60%, rgba(0,0,0,0.1) 100%);
  }

  .tool-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 80px;
  }

  .tool-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 12px;
  }

  .tool-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 400;
    margin-bottom: 12px;
    max-width: 600px;
  }

  .tool-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.8);
    max-width: 500px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .tool-link {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 4px;
    display: inline-block;
    width: fit-content;
  }

  .tool-banner:hover .tool-link {
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .tool-banner {
      height: 60vh;
      min-height: 320px;
    }
    .tool-title {
      font-size: 1.8rem;
    }
    .tool-content {
      padding-bottom: 48px;
    }
  }

  @media (max-width: 480px) {
    .tool-banner {
      height: 50vh;
      min-height: 280px;
      max-height: 400px;
    }
    .tool-title {
      font-size: 1.4rem;
    }
    .tool-desc {
      font-size: 0.9rem;
    }
    .tool-content {
      padding-bottom: 32px;
    }
  }
</style>
