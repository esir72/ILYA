---
const tool = {
  title: 'Набор резцов для резьбы по дереву',
  desc: 'Собственноручно изготовленный набор из трёх резцов. Сталь У8, ручки — кап берёзы.',
  price: 3800,
  image: '/images/10 Mind-Blowing Wood Carving Techniques You Need To Try Today! - The Table Read Magazine.jpg',
};
---

<a href="/tool" class="tool-banner" id="tools" data-animate="fade">
  <div class="tool-image">
    <img src={tool.image} alt="" />
  </div>
  <div class="tool-text">
    <p class="tool-label" data-i18n="tools.label">Инструменты</p>
    <h2 class="tool-title" data-i18n="tools.title">{tool.title}</h2>
    <p class="tool-desc" data-i18n="tools.desc">{tool.desc}</p>
  </div>
</a>

<style>
  .tool-banner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 400px;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .tool-image {
    position: relative;
    overflow: hidden;
  }

  .tool-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .tool-banner:hover .tool-image img {
    transform: scale(1.05);
  }

  .tool-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 50%, var(--surface) 100%);
    pointer-events: none;
  }

  .tool-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 48px 48px 32px;
    color: var(--text);
  }

  .tool-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .tool-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 400;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .tool-desc {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .tool-banner {
      grid-template-columns: 1fr;
      min-height: 320px;
    }
    .tool-image {
      height: 200px;
    }
    .tool-image::after {
      background: linear-gradient(to bottom, transparent 50%, var(--surface) 100%);
    }
    .tool-text {
      padding: 24px 24px 32px;
    }
    .tool-title {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 480px) {
    .tool-banner {
      min-height: auto;
    }
    .tool-image {
      height: 160px;
    }
    .tool-text {
      padding: 20px 16px 24px;
    }
    .tool-title {
      font-size: 1.3rem;
    }
    .tool-desc {
      font-size: 0.9rem;
    }
  }
</style>
