---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title data-i18n="meta.title">Илья — Резьба по дереву</title>
    <meta name="description" content="Ручная работа. Резьба по дереву от Ильи. Уникальные изделия из натурального дерева." data-i18n-content="meta.desc" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oranienbaum&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="particles" id="particles"></div>
    <div class="cursor-glow" id="cursorGlow"></div>
    <div class="petroglyphs" id="petroglyphs" aria-hidden="true"></div>
    <slot />
    <CookieConsent />
    <script is:inline src="/js/i18n.js"></script>
      <script>
      function __t(key, fallback) {
        if (window.i18n && window.i18n.loaded) {
          var val = window.i18n.t(key);
          if (val !== key) return val;
        }
        return fallback;
      }

      function initCart() {
        const overlay = document.getElementById('cart-overlay');
        const cart = document.getElementById('cart');
        const toggle = document.getElementById('cart-toggle');
        const closeBtn = document.getElementById('cart-close');
        const itemsEl = document.getElementById('cart-items');
        const totalEl = document.getElementById('cart-total');
        const countEl = document.getElementById('cart-count');
        const checkoutBtn = document.getElementById('cart-checkout');

        let items = JSON.parse(localStorage.getItem('cart') || '[]');

        function save() {
          localStorage.setItem('cart', JSON.stringify(items));
        }

        function total() {
          return items.reduce((sum, item) => sum + item.price * item.qty, 0);
        }

        function count() {
          return items.reduce((s, item) => s + item.qty, 0);
        }

        function fmtPrice(p) {
          return p.toLocaleString('ru-RU') + ' ₽';
        }

        function render() {
          if (!itemsEl) return;
          if (items.length === 0) {
            itemsEl.innerHTML = '<div class="cart-empty"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><p>' + __t('cart.empty', 'Корзина пуста') + '</p></div>';
          } else {
            itemsEl.innerHTML = items.map(function (item, i) { return (
              '<div class="cart-item">' +
                '<div class="cart-item-info">' +
                  '<div class="cart-item-title">' + (item.i18nKey ? __t(item.i18nKey, item.title) : item.title) + '</div>' +
                  '<div class="cart-item-price">' + fmtPrice(item.price) + '</div>' +
                  '<div class="cart-item-actions">' +
                    '<div class="cart-item-qty">' +
                      '<button class="cart-qty-btn" data-index="' + i + '" data-dir="-1">−</button>' +
                      '<span class="cart-qty-value">' + item.qty + '</span>' +
                      '<button class="cart-qty-btn" data-index="' + i + '" data-dir="1">+</button>' +
                    '</div>' +
                    '<button class="cart-item-remove" data-index="' + i + '">' + __t('cart.remove', 'Удалить') + '</button>' +
                  '</div>' +
                '</div>' +
                '<div class="cart-item-right">' +
                  '<span class="cart-item-subtotal">' + fmtPrice(item.price * item.qty) + '</span>' +
                '</div>' +
              '</div>');
            }).join('');
          }

          totalEl.textContent = fmtPrice(total());
          countEl.textContent = count();
          var badgeEl = document.getElementById('cart-count-badge');
          if (badgeEl) badgeEl.textContent = count();

          itemsEl.querySelectorAll('.cart-qty-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var idx = parseInt(btn.dataset.index);
              var dir = parseInt(btn.dataset.dir);
              items[idx].qty += dir;
              if (items[idx].qty <= 0) items.splice(idx, 1);
              save();
              render();
            });
          });

          itemsEl.querySelectorAll('.cart-item-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
              items.splice(parseInt(btn.dataset.index), 1);
              save();
              render();
            });
          });
        }

        function open() {
          overlay.classList.add('open');
          cart.classList.add('open');
          document.body.style.overflow = 'hidden';
        }

        function close() {
          overlay.classList.remove('open');
          cart.classList.remove('open');
          document.body.style.overflow = '';
        }

        if (toggle) toggle.addEventListener('click', open);
        if (closeBtn) closeBtn.addEventListener('click', close);
        if (overlay) overlay.addEventListener('click', close);
        if (checkoutBtn) checkoutBtn.addEventListener('click', close);

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });

        document.querySelectorAll('.btn-cart').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = parseInt(btn.dataset.id);
            var title = btn.dataset.title;
            var i18nKey = btn.dataset.i18nKey || '';
            var price = parseInt(btn.dataset.price);
            var img = btn.dataset.img || '';
            var existing = items.find(function (item) { return item.id === id; });
            if (existing) {
              existing.qty++;
              existing.i18nKey = i18nKey;
            } else {
              items.push({ id: id, title: title, i18nKey: i18nKey, price: price, qty: 1, img: img });
            }
            save();
            render();
            open();
          });
        });

        render();
      }

      window.initCart = initCart;

      document.addEventListener('DOMContentLoaded', function () {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('animated');
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('[data-animate]').forEach(function (el) { observer.observe(el); });

        initCart();

        var pc = document.getElementById('particles');
        if (pc) {
          for (var i = 0; i < 30; i++) {
            var p = document.createElement('div');
            p.className = 'particle';
            p.style.left = Math.random() * 100 + '%';
            p.style.top = Math.random() * 100 + '%';
            p.style.animationDelay = (Math.random() * 6) + 's';
            p.style.animationDuration = (4 + Math.random() * 4) + 's';
            var size = 2 + Math.random() * 4;
            p.style.width = size + 'px';
            p.style.height = size + 'px';
            pc.appendChild(p);
          }
        }

        var pg = document.getElementById('petroglyphs');
        if (pg) {
          function shuffle(arr) {
            for (var i = arr.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
            }
            return arr;
          }
          var side = [];
          var inner = [];
          for (var pr = 0; pr < 3; pr++) {
            for (var pc = 0; pc < 4; pc++) {
              var cell = { x: pc * 25 + 3 + Math.random() * 14, y: pr * 33.3 + 3 + Math.random() * 14 };
              if (pc === 0 || pc === 3) side.push(cell); else inner.push(cell);
            }
          }
          shuffle(side);
          shuffle(inner);
          var bigCells = side.slice(0, 3);
          var smallCells = side.slice(3).concat(inner);
          var smallIdx = 0;
          var bigIdx = 0;
          for (var pi = 0; pi < 12; pi++) {
            var petroIdx = pi % 10;
            var big = petroIdx >= 7;
            var cell = big ? bigCells[bigIdx++] : smallCells[smallIdx++];
            var g = document.createElement('div');
            g.className = 'petroglyph';
            var rot = (Math.random() - 0.5) * 90;
            g.style.width = (big ? 180 + Math.random() * 70 : 80 + Math.random() * 80) + 'px';
            g.style.left = cell.x + '%';
            g.style.top = cell.y + '%';
            g.style.setProperty('--r', rot.toFixed(1) + 'deg');
            g.style.setProperty('--tx1', (-15 - Math.random() * 10).toFixed(0) + 'px');
            g.style.setProperty('--ty1', (-12 - Math.random() * 10).toFixed(0) + 'px');
            g.style.setProperty('--tx2', (15 + Math.random() * 10).toFixed(0) + 'px');
            g.style.setProperty('--ty2', (12 + Math.random() * 10).toFixed(0) + 'px');
            g.style.setProperty('--dur', (7 + Math.random() * 5).toFixed(1) + 's');
            g.style.setProperty('--delay', (-Math.random() * 7).toFixed(1) + 's');
            g.style.maskImage = "url('/images/imgs/petro-" + petroIdx + ".png')";
            g.style.webkitMaskImage = "url('/images/imgs/petro-" + petroIdx + ".png')";
            pg.appendChild(g);
          }
        }
      });

      document.addEventListener('langchange', function () {
        var cart = document.getElementById('cart-items');
        if (cart) {
          initCart();
        }
        document.querySelectorAll('[data-i18n-title]').forEach(function (el) {
          if (window.i18n && window.i18n.loaded) {
            el.title = window.i18n.t(el.dataset.i18nTitle);
          }
        });
      });

      var ticking = false;
      document.addEventListener('scroll', function () {
        if (!ticking) {
          requestAnimationFrame(function () {
            var header = document.querySelector('.header');
            if (header) {
              header.classList.toggle('scrolled', window.scrollY > 100);
            }
            ticking = false;
          });
          ticking = true;
        }
      });

      var glow = document.getElementById('cursorGlow');
      if (glow) {
        var glowTargetX = 0, glowTargetY = 0, glowCurX = 0, glowCurY = 0;
        var glowRaf = null, glowActive = false;
        document.addEventListener('mousemove', function (e) {
          glowTargetX = e.clientX;
          glowTargetY = e.clientY;
          if (!glowActive) {
            glowActive = true;
            if (glow.style.opacity !== '1') {
              glowCurX = glowTargetX;
              glowCurY = glowTargetY;
              glow.style.opacity = '1';
            }
            glowRaf = requestAnimationFrame(glowLoop);
          }
        });
        function glowLoop() {
          glowCurX += (glowTargetX - glowCurX) * 0.05;
          glowCurY += (glowTargetY - glowCurY) * 0.05;
          glow.style.left = glowCurX + 'px';
          glow.style.top = glowCurY + 'px';
          if (Math.abs(glowTargetX - glowCurX) > 0.5 || Math.abs(glowTargetY - glowCurY) > 0.5) {
            glowRaf = requestAnimationFrame(glowLoop);
          } else {
            glowRaf = null;
            glowActive = false;
          }
        }
      }
    </script>
  </body>
</html>
