---
import Layout from '../../layouts/Layout.astro';
import Cart from '../../components/Cart.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;

const tool = {
  id: 10,
  title: '«ПЕРВЫЙ СЛЕД» Набор для резьбы по дереву',
  price: 11900,
  desc: 'Всё необходимое, чтобы сделать первый шаг в древнее ремесло и почувствовать дерево в своих руках. Набор полностью заточен и готов к работе, а всё вместе собрано в подарочной коробке с напутствием от Илуи.',
  details: [
    'Брусок мягкой липы — материал для вашего первого изделия.',
    'Богородский нож 50 мм — для точной резьбы и мелких деталей.',
    'Ложкорез — для глубоких выборок и аккуратных углублений.',
  ],
  specs: {
    'Сталь': 'Нож и ложкорез, закалка 58-60 HRC',
    'Ручки': 'Кап берёзы, льняное масло',
    'Чехол': 'Подарочная коробка',
    'Вес': '1,6 кг (набор)',
  },
  images: [
    `${base}/images/cards/set/set-1.png`,
    `${base}/images/cards/set/photo_2026-09-21_16-18-23.webp`,
    `${base}/images/cards/set/photo_2026-09-21_16-18-31.webp`,
    `${base}/images/cards/set/photo_2026-09-21_16-18-33.webp`,
  ],
};

const imageSizes = [
  { width: 1254, height: 1254 },
  { width: 1280, height: 853 },
  { width: 1280, height: 960 },
  { width: 1280, height: 960 }
];

const formatPrice = (price: number): string => `${price.toLocaleString('ru-RU')} ₽`;
---

<Layout title={tool.title} titleKey="toolPage.title" description={tool.desc} descriptionKey="toolPage.metaDesc">
  <header class="detail-header">
    <div class="container detail-header-inner">
      <a href={homeHref} class="detail-back" data-i18n="toolPage.back">← На главную</a>
      <button id="cart-toggle" class="cart-toggle" aria-label="Корзина" data-i18n-aria="header.cartLabel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span id="cart-count" class="cart-count">0</span>
      </button>
    </div>
  </header>
  <main>
    <section class="detail">
      <div class="container">
        <div class="detail-layout">
          <div class="detail-gallery" data-animate="left">
            <div class="gallery-main" id="detail-gallery">
              {tool.images.map((src, i) => (
                 <img src={src} width={imageSizes[i]?.width} height={imageSizes[i]?.height} alt={`${tool.title} — фото ${i + 1}`} class="gallery-img" data-index={i} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              ))}
            </div>
            <div class="gallery-thumbs">
              {tool.images.map((src, i) => (
                <button class="thumb-btn" data-index={i}>
                   <img src={src} width={imageSizes[i]?.width} height={imageSizes[i]?.height} alt="" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
          <div class="detail-info" data-animate="right">
            <h1 class="detail-title" data-i18n="toolPage.title">{tool.title}</h1>
            <p class="detail-desc" data-i18n="toolPage.desc">{tool.desc}</p>
            <ul class="detail-list">
              {tool.details.map((d, i) => <li data-i18n={`toolPage.detail.${i}`}>{d}</li>)}
            </ul>
            <div class="detail-specs">
              {Object.entries(tool.specs).map(([key, val]) => (
                <div class="spec-row">
                  <span class="spec-key" data-i18n={`toolPage.specKey.${key}`}>{key}</span>
                  <span class="spec-val" data-i18n={`toolPage.specValue.${key}`}>{val}</span>
                </div>
              ))}
            </div>
            <div class="detail-bottom">
              <span class="detail-price" data-i18n="toolPage.price">{formatPrice(tool.price)}</span>
              <button class="btn btn-cart" data-id={tool.id} data-title={tool.title} data-i18n-key="toolPage.title" data-price={tool.price} data-img={tool.images[0]} data-i18n="toolPage.btnCart">
                В корзину
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Cart checkoutHref={`${homeHref}#payment`} />

  <script>
    const images = document.querySelectorAll<HTMLImageElement>('#detail-gallery .gallery-img');
    const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

    function show(index: number): void {
      images.forEach((img, i) => img.classList.toggle('active', i === index));
      thumbs.forEach((btn, i) => btn.classList.toggle('active', i === index));
    }

    if (images.length > 0) show(0);

    thumbs.forEach(btn => btn.addEventListener('click', () => {
      const rawIndex = btn.dataset.index;
      if (rawIndex === undefined) return;
      const index = parseInt(rawIndex, 10);
      if (Number.isNaN(index)) return;
      show(index);
    }));
  </script>
</Layout>

<style>
  .detail-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(27, 15, 8, 0.88);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
    height: 64px;
    display: flex;
    align-items: center;
  }

  .detail-back {
    font-size: 0.95rem;
    color: var(--text-light);
  }

  .detail-back:hover {
    color: var(--text);
  }

  .detail-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .cart-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-light);
    padding: 4px;
    position: relative;
    transition: color 0.2s;
  }

  .cart-toggle:hover {
    color: var(--text);
  }

  .cart-count {
    position: absolute;
    top: -4px;
    right: -6px;
    width: 18px;
    height: 18px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 400;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail {
    padding: 120px 0 80px;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .gallery-main {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--beige);
    position: relative;
  }

  .gallery-main .gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .gallery-main .gallery-img.active {
    opacity: 1;
  }

  .gallery-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .thumb-btn {
    width: 64px;
    height: 64px;
    border: 1px solid var(--border);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    background: var(--beige);
  }

  .thumb-btn.active {
    border-color: var(--accent);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-title {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .detail-desc {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .detail-list {
    list-style: none;
    padding: 0;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .detail-list li {
    padding-left: 20px;
    position: relative;
    color: var(--text-light);
  }

  .detail-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .detail-specs {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 20px 0;
    margin-bottom: 24px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
  }

  .spec-key {
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .spec-val {
    font-weight: 500;
  }

  .detail-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .detail-price {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .detail-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .detail {
      padding: 100px 0 60px;
    }
    .detail-title {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    .detail {
      padding: 80px 0 40px;
    }
    .detail-title {
      font-size: 1.4rem;
    }
    .spec-row {
      flex-direction: column;
      gap: 2px;
      padding: 6px 0;
    }
    .detail-bottom {
      flex-direction: column;
      gap: 16px;
      align-items: stretch;
    }
    .detail-price {
      text-align: center;
    }
    .detail-bottom .btn {
      width: 100%;
    }
    .gallery-thumbs {
      flex-wrap: wrap;
    }
  }
</style>
