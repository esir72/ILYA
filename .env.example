# Build-time URL for the Vercel API function. Set this as a GitHub Actions
# repository variable so the GitHub Pages build points to the deployed API.
PUBLIC_ORDER_API_URL=https://your-vercel-project.vercel.app/api/order

# SMTP settings for the Vercel API function
SITE_ORIGIN=https://ilya-wood.shop
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-mailbox-app-password
ORDER_EMAIL_TO=you@example.com
